---
import { getGenerationLabel } from "../../config/generations";
import Layout from "../../layouts/Layout.astro";
import { getValidatedStreamers } from "../../lib/streamers";
import { getSchoolYearRange, groupBySchoolYear } from "../../utils/generation";

const streamers = await getValidatedStreamers();
const generations = groupBySchoolYear(streamers);
---

<Layout
  title="同学年で配信者を探す | 配信者年齢サイト"
  description="配信者を生年月日から日本の一般的な学年区分でまとめた年度別一覧です。"
  canonicalPath="/generations/"
>
  <main class="generations-page">
    <section class="generations-hero" aria-labelledby="generations-heading">
      <div class="generations-hero__inner">
        <p class="generations-hero__eyebrow">STREAMER GENERATIONS</p>
        <h1 id="generations-heading">同学年で探す</h1>
        <p class="generations-hero__lead">
          配信者を生年月日から年度別にまとめています。
        </p>
        <p class="generations-hero__note">
          4月2日から翌年4月1日までを同じ年度として分類しています。実際に同じ学校へ通っていたことを示すものではありません。
        </p>
      </div>
    </section>

    <section class="generations-content" aria-labelledby="generation-list-heading">
      <div class="generations-content__heading">
        <div>
          <p>GENERATIONS</p>
          <h2 id="generation-list-heading">年度別配信者一覧</h2>
        </div>
        <p>{generations.length}年度を掲載</p>
      </div>

      <div class="generation-grid">
        {generations.map(({ year, members }) => {
          const range = getSchoolYearRange(year);

          return (
            <a
              class="generation-card"
              href={`/generations/${year}/`}
              data-generation-link
              data-generation-year={year}
            >
              <span class="generation-card__year">
                {getGenerationLabel(year)}
              </span>
              <strong>{members.length}<span>人</span></strong>
              <span class="generation-card__range">{range.label}</span>
              <span class="generation-card__action">
                配信者を見る <span aria-hidden="true">→</span>
              </span>
            </a>
          );
        })}
      </div>
    </section>
  </main>
</Layout>

<style>
  .generations-page {
    min-width: 0;
  }

  .generations-hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 82% 12%, rgb(117 89 232 / 24%), transparent 34%),
      radial-gradient(circle at 12% 95%, rgb(32 184 165 / 14%), transparent 30%),
      var(--color-navy);
    color: #fff;
  }

  .generations-hero::after {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 3%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 3%) 1px, transparent 1px);
    background-size: 42px 42px;
    content: "";
    mask-image: linear-gradient(to bottom, #000, transparent 92%);
    pointer-events: none;
  }

  .generations-hero__inner,
  .generations-content {
    width: min(calc(100% - 40px), var(--content-width));
    margin-inline: auto;
  }

  .generations-hero__inner {
    position: relative;
    z-index: 1;
    padding-block: 64px;
  }

  .generations-hero__eyebrow,
  .generations-content__heading > div > p {
    margin: 0 0 9px;
    color: #7ce0d2;
    letter-spacing: 0.14em;
    font-size: 11px;
    font-weight: 800;
  }

  h1 {
    margin: 0;
    font-size: clamp(38px, 6vw, 58px);
    letter-spacing: -0.035em;
    line-height: 1.14;
  }

  .generations-hero__lead {
    margin: 17px 0 0;
    color: #d9e1f2;
    font-size: clamp(16px, 2vw, 18px);
  }

  .generations-hero__note {
    max-width: 760px;
    margin: 18px 0 0;
    color: var(--color-text-on-dark-muted);
    font-size: 13px;
    line-height: 1.75;
  }

  .generations-content {
    padding-block: 48px 24px;
  }

  .generations-content__heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 24px;
  }

  .generations-content__heading > div > p {
    color: var(--color-teal);
  }

  .generations-content__heading h2,
  .generations-content__heading > p {
    margin: 0;
  }

  .generations-content__heading h2 {
    font-size: clamp(25px, 4vw, 34px);
    letter-spacing: -0.025em;
  }

  .generations-content__heading > p {
    color: var(--color-text-muted);
    font-size: 14px;
  }

  .generation-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 18px;
  }

  .generation-card {
    display: grid;
    min-width: 0;
    gap: 12px;
    padding: 24px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-large);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    color: inherit;
    text-decoration: none;
    transition:
      border-color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .generation-card:hover {
    border-color: #c8c0f5;
    box-shadow: 0 18px 48px rgb(15 23 42 / 13%);
    transform: translateY(-3px);
  }

  .generation-card:focus-visible {
    outline: 3px solid rgb(117 89 232 / 35%);
    outline-offset: 3px;
  }

  .generation-card__year {
    overflow-wrap: anywhere;
    font-size: 19px;
    font-weight: 800;
  }

  .generation-card strong {
    color: var(--color-purple);
    font-size: 38px;
    line-height: 1;
  }

  .generation-card strong span {
    margin-left: 3px;
    font-size: 14px;
  }

  .generation-card__range {
    color: var(--color-text-muted);
    font-size: 13px;
  }

  .generation-card__action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 5px;
    color: #5842bd;
    font-size: 13px;
    font-weight: 800;
  }

  @media (max-width: 600px) {
    .generations-hero__inner,
    .generations-content {
      width: min(calc(100% - 32px), var(--content-width));
    }

    .generations-hero__inner {
      padding-block: 42px;
    }

    .generations-content {
      padding-top: 36px;
    }

    .generations-content__heading {
      align-items: center;
    }

    .generation-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 14px;
    }

    .generation-card {
      padding: 20px;
    }
  }

  @media (max-width: 340px) {
    .generations-hero__inner,
    .generations-content {
      width: min(calc(100% - 24px), var(--content-width));
    }

    .generations-content__heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }
  }
</style>
