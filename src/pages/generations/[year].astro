---
import type { GetStaticPaths } from "astro";
import { getGenerationLabel } from "../../config/generations";
import Layout from "../../layouts/Layout.astro";
import type { Streamer } from "../../lib/streamers";
import { getValidatedStreamers } from "../../lib/streamers";
import { calculateAge } from "../../utils/age";
import { getSchoolYearRange, groupBySchoolYear } from "../../utils/generation";

interface Props {
  year: number;
  streamers: Streamer[];
}

export const getStaticPaths = (async () => {
  const streamers = await getValidatedStreamers();

  return groupBySchoolYear(streamers).map(({ year, members }) => ({
    params: { year: String(year) },
    props: {
      year,
      streamers: [...members].sort((left, right) =>
        (left.birthDate ?? "").localeCompare(right.birthDate ?? "")
      )
    }
  }));
}) satisfies GetStaticPaths;

const { year, streamers } = Astro.props as Props;
const generationLabel = getGenerationLabel(year);
const range = getSchoolYearRange(year);

function formatBirthDate(birthDate: string) {
  const [birthYear, month, day] = birthDate.split("-").map(Number);
  return `${birthYear}年${month}月${day}日`;
}
---

<Layout
  title={`${generationLabel}の配信者一覧 | STREAMER AGE`}
  description={`${range.label}生まれの配信者${streamers.length}人を、年齢・誕生日・所属・ジャンルとともに紹介します。`}
  canonicalPath={`/generations/${year}/`}
>
  <main class="generation-page">
    <section class="generation-hero" aria-labelledby="generation-heading">
      <div class="generation-hero__inner">
        <a href="/generations/" class="back-link">← 年度一覧に戻る</a>
        <p class="generation-hero__eyebrow">STREAMER GENERATION</p>
        <h1 id="generation-heading"><span>{generationLabel}</span><span>の配信者</span></h1>
        <p class="generation-hero__range">{range.label}生まれ</p>
        <p class="generation-hero__note">
          生年月日を基準にした一般的な日本の学年区分です。実際に同じ学校へ通っていたことを示すものではありません。
        </p>
      </div>
    </section>

    <section class="generation-content" aria-labelledby="generation-streamers-heading">
      <div class="generation-content__heading">
        <div>
          <p>STREAMERS</p>
          <h2 id="generation-streamers-heading">登録配信者</h2>
        </div>
        <p><strong>{streamers.length}</strong>人を掲載</p>
      </div>

      <div class="generation-streamer-grid">
        {streamers.map((streamer) => {
          const age = calculateAge(streamer.birthDate);
          const birthDate = streamer.birthDate!;
          const initial = streamer.name.trim().charAt(0).toUpperCase();

          return (
            <article class="generation-streamer-card" data-generation-streamer>
              <a href={`/streamers/${streamer.slug}/`}>
                <div class="generation-streamer-card__header">
                  <div class="generation-streamer-card__avatar">
                    {streamer.profileImage ? (
                      <img
                        src={streamer.profileImage}
                        alt={`${streamer.name}のプロフィール画像`}
                        width="64"
                        height="64"
                        loading="lazy"
                      />
                    ) : (
                      <span aria-hidden="true">{initial}</span>
                    )}
                  </div>
                  <div class="generation-streamer-card__identity">
                    <h2>{streamer.name}</h2>
                    {streamer.affiliation && <p>{streamer.affiliation}</p>}
                  </div>
                </div>

                <div class="genre-list" aria-label="ジャンル">
                  {streamer.genres.map((genre) => <span>{genre}</span>)}
                </div>

                <dl class="generation-streamer-card__facts">
                  <div>
                    <dt>現在の年齢</dt>
                    <dd data-birth={birthDate}>{age === null ? "非公開" : `${age}歳`}</dd>
                  </div>
                  <div>
                    <dt>生年月日</dt>
                    <dd><time datetime={birthDate}>{formatBirthDate(birthDate)}</time></dd>
                  </div>
                </dl>

                <span class="generation-streamer-card__action">
                  プロフィールを見る <span aria-hidden="true">→</span>
                </span>
              </a>
            </article>
          );
        })}
      </div>
    </section>
  </main>
</Layout>

<style>
  .generation-page {
    min-width: 0;
  }

  .generation-hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 82% 12%, rgb(117 89 232 / 24%), transparent 34%),
      radial-gradient(circle at 12% 95%, rgb(32 184 165 / 14%), transparent 30%),
      var(--color-navy);
    color: #fff;
  }

  .generation-hero::after {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 3%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 3%) 1px, transparent 1px);
    background-size: 42px 42px;
    content: "";
    mask-image: linear-gradient(to bottom, #000, transparent 92%);
    pointer-events: none;
  }

  .generation-hero__inner,
  .generation-content {
    width: min(calc(100% - 40px), var(--content-width));
    margin-inline: auto;
  }

  .generation-hero__inner {
    position: relative;
    z-index: 1;
    padding-block: 28px 54px;
  }

  .back-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: #c7d2e8;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
  }

  .back-link:hover {
    color: #fff;
    text-decoration: underline;
  }

  .back-link:focus-visible,
  .generation-streamer-card a:focus-visible {
    border-radius: 8px;
    outline: 3px solid rgb(32 184 165 / 50%);
    outline-offset: 3px;
  }

  .generation-hero__eyebrow,
  .generation-content__heading > div > p {
    margin: 25px 0 9px;
    color: #7ce0d2;
    letter-spacing: 0.14em;
    font-size: 11px;
    font-weight: 800;
  }

  h1 {
    margin: 0;
    overflow-wrap: anywhere;
    font-size: clamp(36px, 6vw, 58px);
    letter-spacing: -0.035em;
    line-height: 1.14;
  }

  .generation-hero__range {
    margin: 17px 0 0;
    color: #d9e1f2;
    font-size: clamp(16px, 2vw, 18px);
    font-weight: 700;
  }

  .generation-hero__note {
    max-width: 760px;
    margin: 14px 0 0;
    color: var(--color-text-on-dark-muted);
    font-size: 13px;
    line-height: 1.75;
  }

  .generation-content {
    padding-block: 48px 24px;
  }

  .generation-content__heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 24px;
  }

  .generation-content__heading > div > p {
    margin-top: 0;
    color: var(--color-teal);
  }

  .generation-content__heading h2,
  .generation-content__heading > p {
    margin: 0;
  }

  .generation-content__heading h2 {
    font-size: clamp(25px, 4vw, 34px);
    letter-spacing: -0.025em;
  }

  .generation-content__heading > p {
    color: var(--color-text-muted);
    font-size: 14px;
  }

  .generation-content__heading strong {
    margin-right: 3px;
    color: var(--color-purple);
    font-size: 24px;
  }

  .generation-streamer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 330px), 1fr));
    gap: 20px;
  }

  .generation-streamer-card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-large);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    transition:
      border-color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .generation-streamer-card:hover {
    border-color: #c8c0f5;
    box-shadow: 0 18px 48px rgb(15 23 42 / 13%);
    transform: translateY(-3px);
  }

  .generation-streamer-card > a {
    display: flex;
    min-height: 100%;
    flex-direction: column;
    padding: 22px;
    color: inherit;
    text-decoration: none;
  }

  .generation-streamer-card__header {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 14px;
  }

  .generation-streamer-card__avatar {
    display: grid;
    width: 64px;
    height: 64px;
    flex: 0 0 64px;
    overflow: hidden;
    place-items: center;
    border-radius: 17px;
    background: linear-gradient(145deg, var(--color-purple-soft), var(--color-teal-soft));
    color: var(--color-purple);
    font-size: 26px;
    font-weight: 800;
  }

  .generation-streamer-card__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .generation-streamer-card__identity {
    min-width: 0;
  }

  .generation-streamer-card__identity h2 {
    margin: 0;
    overflow-wrap: anywhere;
    font-size: 25px;
    line-height: 1.18;
  }

  .generation-streamer-card__identity p {
    margin: 6px 0 0;
    overflow-wrap: anywhere;
    color: var(--color-text-muted);
    font-size: 12px;
    font-weight: 600;
  }

  .genre-list {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 18px;
  }

  .genre-list span {
    padding: 5px 10px;
    border: 1px solid #dcd6ff;
    border-radius: 999px;
    background: var(--color-purple-soft);
    color: #5842bd;
    font-size: 12px;
    font-weight: 700;
  }

  .generation-streamer-card__facts {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 1px;
    margin: 20px 0 0;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 13px;
    background: var(--color-border);
  }

  .generation-streamer-card__facts div {
    min-width: 0;
    padding: 13px;
    background: #fafbfe;
  }

  .generation-streamer-card__facts dt {
    color: var(--color-text-muted);
    font-size: 11px;
    font-weight: 700;
  }

  .generation-streamer-card__facts dd {
    margin: 5px 0 0;
    overflow-wrap: anywhere;
    font-size: 13px;
    font-weight: 700;
  }

  .generation-streamer-card__facts div:first-child dd {
    color: var(--color-purple);
    font-size: 22px;
    line-height: 1;
  }

  .generation-streamer-card__action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 20px;
    color: #5842bd;
    font-size: 13px;
    font-weight: 800;
  }

  @media (max-width: 600px) {
    .generation-hero__inner,
    .generation-content {
      width: min(calc(100% - 32px), var(--content-width));
    }

    .generation-hero__inner {
      padding-block: 18px 40px;
    }

    .generation-hero__eyebrow {
      margin-top: 18px;
    }

    h1 span {
      display: block;
    }

    .generation-content {
      padding-top: 36px;
    }

    .generation-streamer-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 14px;
    }

    .generation-streamer-card > a {
      padding: 20px;
    }
  }

  @media (max-width: 340px) {
    .generation-hero__inner,
    .generation-content {
      width: min(calc(100% - 24px), var(--content-width));
    }

    .generation-content__heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }

    .generation-streamer-card__facts div {
      padding: 11px;
    }
  }
</style>
