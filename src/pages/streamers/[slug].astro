---
import type { GetStaticPaths } from "astro";
import DeviceList from "../../components/DeviceList.astro";
import Layout from "../../layouts/Layout.astro";
import { getDisplayProfileImage } from "../../lib/profile-image";
import type { Streamer } from "../../lib/streamers";
import { getValidatedStreamers } from "../../lib/streamers";
import { calculateAge } from "../../utils/age";
import { getSchoolYear } from "../../utils/generation";

// JSONに登録された配信者ごとにページを生成
export const getStaticPaths = (async () => {
  const streamers = await getValidatedStreamers();

  return streamers.map((streamer) => ({
    params: { slug: streamer.slug },
    props: { streamer }
  }));
}) satisfies GetStaticPaths;

const { streamer } = Astro.props as { streamer: Streamer };

const age = calculateAge(streamer.birthDate);
const schoolYear = getSchoolYear(streamer.birthDate);
const initial = streamer.name.trim().charAt(0).toUpperCase();
const profileImage = getDisplayProfileImage(streamer.profileImage);
const birthDateSources = streamer.birthDate
  ? streamer.sources.filter((source) => source.field === "birthDate")
  : [];

function formatBirthDate(birthDate: string | null) {
  if (!birthDate) return "非公開";

  const [year, month, day] = birthDate.split("-").map(Number);
  return `${year}年${month}月${day}日`;
}

---

<Layout
  title={`${streamer.name}の年齢・プロフィール | STREAMER AGE`}
  description={`${streamer.name}の年齢・誕生日・プロフィール・使用デバイスを紹介します。`}
  canonicalPath={`/streamers/${streamer.slug}/`}
  ogType="profile"
  image={profileImage?.src}
>
  <main class="profile-page">
    <section class="profile-hero" aria-labelledby="profile-name">
      <div class="profile-hero__inner">
        <a href="/" class="back-link">← 配信者一覧に戻る</a>

        <div class="profile-hero__content">
          <div class="profile-avatar">
            {profileImage ? (
              <img
                src={profileImage.src}
                alt={profileImage.alt}
                width="112"
                height="112"
                decoding="async"
              />
            ) : (
              <span aria-hidden="true">{initial}</span>
            )}
            {profileImage?.credit && (
              <small class="profile-image-credit">{profileImage.credit}</small>
            )}
          </div>

          <div class="profile-hero__identity">
            <p class="profile-hero__eyebrow">STREAMER PROFILE</p>
            <h1 id="profile-name">{streamer.name}</h1>

            <div class="profile-hero__meta">
              <p>読み：{streamer.nameKana}</p>
              {streamer.aliases.length > 0 && (
                <p>別名：{streamer.aliases.join("・")}</p>
              )}
              <p>所属：{streamer.affiliation ?? "なし"}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="profile-content">
      <section class="key-facts" aria-label="年齢と誕生日">
        <div class="fact-card fact-card--age">
          <p class="fact-card__label">現在の年齢</p>
          <p class="fact-card__value" data-birth={streamer.birthDate ?? ""}>
            {age === null ? "非公開" : `${age}歳`}
          </p>
        </div>

        <div class="fact-card">
          <p class="fact-card__label">生年月日</p>
          <p class="fact-card__value fact-card__value--date">
            {streamer.birthDate ? (
              <time datetime={streamer.birthDate}>
                {formatBirthDate(streamer.birthDate)}
              </time>
            ) : (
              "非公開"
            )}
          </p>
        </div>
      </section>

      {schoolYear !== null && (
        <aside class="generation-guide">
          <div>
            <p class="generation-guide__label">{schoolYear}年度生まれ</p>
            <p class="generation-guide__note">
              生年月日を基準にした学年区分です。実際に同じ学校へ通っていたことを示すものではありません。
            </p>
          </div>
          <a
            href={`/generations/${schoolYear}/`}
            data-profile-generation-link
          >
            同じ学年の配信者を見る <span aria-hidden="true">→</span>
          </a>
        </aside>
      )}

      <div class="profile-grid">
        <section class="section-card">
          <div class="section-heading">
            <p>PROFILE</p>
            <h2>活動ジャンル</h2>
          </div>

          <div class="genre-list">
            {streamer.genres.map((genre) => <span>{genre}</span>)}
          </div>
        </section>

        <section class="section-card">
          <div class="section-heading">
            <p>OFFICIAL LINKS</p>
            <h2>公式SNS・配信先</h2>
          </div>

          <div class="social-links">
            {streamer.socialLinks.youtube && (
              <a
                href={streamer.socialLinks.youtube}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="social-links__mark" aria-hidden="true">YT</span>
                <span>YouTube</span>
                <span aria-hidden="true">↗</span>
              </a>
            )}
            {streamer.socialLinks.twitch && (
              <a
                href={streamer.socialLinks.twitch}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="social-links__mark" aria-hidden="true">TW</span>
                <span>Twitch</span>
                <span aria-hidden="true">↗</span>
              </a>
            )}
            {streamer.socialLinks.x && (
              <a
                href={streamer.socialLinks.x}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="social-links__mark" aria-hidden="true">X</span>
                <span>X</span>
                <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        </section>
      </div>

      <section class="section-card section-card--wide">
        <div class="section-heading">
          <p>DEVICES</p>
          <h2>使用デバイス</h2>
        </div>

        <DeviceList devices={streamer.devices ?? []} />
      </section>

      {birthDateSources.length > 0 && (
        <section
          class="section-card section-card--sources"
          data-birth-date-sources
        >
          <div class="section-heading">
            <p>SOURCE</p>
            <h2>生年月日の出典</h2>
          </div>

          <ul class="source-list">
            {birthDateSources.map((source) => (
              <li>
                <a
                  href={source.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  生年月日の出典
                  <span aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ul>

          <p class="last-verified">
            最終確認日：<time datetime={streamer.lastVerifiedAt}>
              {streamer.lastVerifiedAt}
            </time>
          </p>
        </section>
      )}
    </div>
  </main>
</Layout>

<style>
  .profile-page {
    min-width: 0;
  }

  .profile-hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 82% 15%, rgb(117 89 232 / 24%), transparent 34%),
      radial-gradient(circle at 12% 95%, rgb(32 184 165 / 14%), transparent 30%),
      var(--color-navy);
    color: #fff;
  }

  .profile-hero::after {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 3%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 3%) 1px, transparent 1px);
    background-size: 42px 42px;
    content: "";
    mask-image: linear-gradient(to bottom, #000, transparent 92%);
    pointer-events: none;
  }

  .profile-hero__inner,
  .profile-content {
    width: min(calc(100% - 40px), var(--content-width));
    margin-inline: auto;
  }

  .profile-hero__inner {
    position: relative;
    z-index: 1;
    padding-block: 30px 58px;
  }

  .back-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: #c7d2e8;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
  }

  .back-link:hover {
    color: #fff;
    text-decoration: underline;
  }

  .back-link:focus-visible,
  .generation-guide a:focus-visible,
  .social-links a:focus-visible,
  .source-list a:focus-visible {
    border-radius: 8px;
    outline: 3px solid rgb(32 184 165 / 50%);
    outline-offset: 3px;
  }

  .profile-hero__content {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 28px;
    margin-top: 30px;
  }

  .profile-avatar {
    position: relative;
    display: grid;
    width: 112px;
    height: 112px;
    flex: 0 0 112px;
    overflow: hidden;
    place-items: center;
    border: 1px solid rgb(255 255 255 / 18%);
    border-radius: 28px;
    background: linear-gradient(145deg, rgb(117 89 232 / 38%), rgb(32 184 165 / 32%));
    box-shadow: 0 20px 48px rgb(0 0 0 / 22%);
    color: #fff;
    font-size: 46px;
    font-weight: 800;
  }

  .profile-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .profile-image-credit {
    position: absolute;
    right: 5px;
    bottom: 5px;
    left: 5px;
    overflow: hidden;
    padding: 3px 5px;
    border-radius: 5px;
    background: rgb(11 16 32 / 82%);
    color: #fff;
    font-size: 8px;
    font-weight: 600;
    line-height: 1.25;
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .profile-hero__identity {
    min-width: 0;
  }

  .profile-hero__eyebrow,
  .section-heading > p {
    margin: 0 0 8px;
    color: #7ce0d2;
    letter-spacing: 0.14em;
    font-size: 11px;
    font-weight: 800;
  }

  h1 {
    margin: 0;
    overflow-wrap: anywhere;
    font-size: clamp(42px, 7vw, 68px);
    letter-spacing: -0.04em;
    line-height: 1.08;
  }

  .profile-hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin-top: 18px;
    color: var(--color-text-on-dark-muted);
    font-size: 14px;
  }

  .profile-hero__meta p {
    min-width: 0;
    margin: 0;
    overflow-wrap: anywhere;
  }

  .profile-content {
    padding-block: 40px 10px;
  }

  .key-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .fact-card,
  .section-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-large);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
  }

  .fact-card {
    position: relative;
    min-width: 0;
    overflow: hidden;
    padding: 25px 28px;
  }

  .fact-card::before {
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: var(--color-teal);
    content: "";
  }

  .fact-card--age::before {
    background: var(--color-purple);
  }

  .fact-card__label {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 13px;
    font-weight: 700;
  }

  .fact-card__value {
    margin: 8px 0 0;
    overflow-wrap: anywhere;
    color: var(--color-purple);
    font-size: clamp(34px, 5vw, 48px);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }

  .fact-card__value--date {
    color: var(--color-text);
    font-size: clamp(24px, 4vw, 34px);
  }

  .profile-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 20px;
    margin-top: 20px;
  }

  .generation-guide {
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: 20px;
    padding: 18px 22px;
    border: 1px solid #dcd6ff;
    border-radius: 16px;
    background: linear-gradient(110deg, var(--color-purple-soft), var(--color-teal-soft));
  }

  .generation-guide__label,
  .generation-guide__note {
    margin: 0;
  }

  .generation-guide__label {
    color: #5842bd;
    font-size: 15px;
    font-weight: 800;
  }

  .generation-guide__note {
    margin-top: 5px;
    color: var(--color-text-muted);
    font-size: 12px;
    line-height: 1.6;
  }

  .generation-guide a {
    display: inline-flex;
    min-height: 44px;
    flex: 0 0 auto;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border-radius: 11px;
    background: #5b36c8;
    color: #fff;
    font-size: 13px;
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
  }

  .generation-guide a:hover {
    background: #4726a8;
  }

  .section-card {
    min-width: 0;
    padding: 28px;
  }

  .section-card--wide,
  .section-card--sources {
    margin-top: 20px;
  }

  .section-heading {
    margin-bottom: 22px;
  }

  .section-heading > p {
    color: var(--color-teal);
  }

  .section-heading h2 {
    margin: 0;
    color: var(--color-text);
    font-size: 21px;
    letter-spacing: -0.02em;
  }

  .genre-list {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
  }

  .genre-list span {
    padding: 7px 12px;
    border: 1px solid #dcd6ff;
    border-radius: 999px;
    background: var(--color-purple-soft);
    color: #5842bd;
    font-size: 13px;
    font-weight: 700;
  }

  .social-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 10px;
  }

  .social-links a {
    display: grid;
    min-width: 0;
    min-height: 52px;
    grid-template-columns: 32px minmax(0, 1fr) auto;
    gap: 10px;
    align-items: center;
    padding: 9px 12px;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    color: var(--color-text);
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    transition:
      border-color 160ms ease,
      background 160ms ease;
  }

  .social-links a:hover {
    border-color: #c8c0f5;
    background: var(--color-purple-soft);
  }

  .social-links__mark {
    display: grid;
    width: 32px;
    height: 32px;
    place-items: center;
    border-radius: 9px;
    background: var(--color-navy-soft);
    color: #fff;
    font-size: 10px;
    letter-spacing: 0.02em;
  }

  .source-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .source-list a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 8px;
    padding: 9px 13px;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    color: #5842bd;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
  }

  .source-list a:hover {
    border-color: #c8c0f5;
    background: var(--color-purple-soft);
  }

  .last-verified {
    margin: 20px 0 0;
    color: var(--color-text-muted);
    font-size: 13px;
  }

  @media (max-width: 768px) {
    .profile-hero__inner {
      padding-bottom: 48px;
    }

    .profile-grid {
      grid-template-columns: 1fr;
    }

    .generation-guide {
      align-items: flex-start;
      flex-direction: column;
      gap: 14px;
    }
  }

  @media (max-width: 600px) {
    .profile-hero__inner,
    .profile-content {
      width: min(calc(100% - 32px), var(--content-width));
    }

    .profile-hero__inner {
      padding-block: 18px 38px;
    }

    .profile-hero__content {
      align-items: flex-start;
      gap: 18px;
      margin-top: 18px;
    }

    .profile-avatar {
      width: 82px;
      height: 82px;
      flex-basis: 82px;
      border-radius: 21px;
      font-size: 34px;
    }

    h1 {
      font-size: clamp(34px, 11vw, 46px);
    }

    .profile-hero__meta {
      flex-direction: column;
      gap: 5px;
      margin-top: 12px;
    }

    .profile-content {
      padding-top: 24px;
    }

    .key-facts {
      grid-template-columns: minmax(0, 1fr);
      gap: 14px;
    }

    .fact-card,
    .section-card {
      padding: 20px;
    }

    .profile-grid,
    .generation-guide,
    .section-card--wide,
    .section-card--sources {
      margin-top: 14px;
    }

    .generation-guide {
      padding: 18px;
    }

    .generation-guide a {
      width: 100%;
      justify-content: space-between;
      white-space: normal;
    }

    .social-links {
      grid-template-columns: 1fr;
    }

    .source-list {
      flex-direction: column;
    }

    .source-list a {
      width: 100%;
      justify-content: space-between;
    }
  }

  @media (max-width: 380px) {
    .profile-hero__content {
      flex-direction: column;
    }
  }

  @media (max-width: 340px) {
    .profile-hero__inner,
    .profile-content {
      width: min(calc(100% - 24px), var(--content-width));
    }

    h1 {
      font-size: 33px;
    }
  }
</style>
