
---
import type { GetStaticPaths } from "astro";
import Layout from "../../layouts/Layout.astro";
import type { Streamer } from "../../lib/streamers";
import { getValidatedStreamers } from "../../lib/streamers";
import { calculateAge } from "../../utils/age";

// JSONに登録された配信者ごとにページを生成
export const getStaticPaths = (async () => {
  const streamers = await getValidatedStreamers();

  return streamers.map((streamer) => ({
    params: { slug: streamer.slug },
    props: { streamer }
  }));
}) satisfies GetStaticPaths;

const { streamer } = Astro.props as { streamer: Streamer };

const age = calculateAge(streamer.birthDate);
const devices = streamer.devices ?? [];

const sourceLabels: Record<string, string> = {
  birthDate: "生年月日",
  affiliation: "所属",
  socialLinks: "公式SNS",
  aliases: "別名"
};
---

<Layout
  title={`${streamer.name}の年齢・プロフィール | 配信者年齢サイト`}
  description={`${streamer.name}の年齢・誕生日・プロフィール・使用デバイスを紹介します。`}
>
    <main>
      <a href="/" class="back">← トップページに戻る</a>

      <article class="profile">
        <header>
          <h1>
            {streamer.name}
            {streamer.aliases.length > 0 && (
              <span class="alias">
                （{streamer.aliases.join("・")}）
              </span>
            )}
          </h1>
          <p>読み：{streamer.nameKana}</p>
        </header>

        <section>
          <h2>基本プロフィール</h2>

          <dl>
            <dt>年齢</dt>
            <dd>
              <strong data-birth={streamer.birthDate ?? ""}>
                {age === null ? "非公開" : `${age}歳`}
              </strong>
            </dd>

            <dt>生年月日</dt>
            <dd>{streamer.birthDate ?? "非公開"}</dd>

            <dt>ジャンル</dt>
            <dd>{streamer.genres.join("・")}</dd>

            <dt>所属</dt>
            <dd>{streamer.affiliation ?? "なし"}</dd>
          </dl>
        </section>

        <section>
          <h2>公式SNS・配信サイト</h2>
          <div class="links">
            {streamer.socialLinks.youtube && (
              <a href={streamer.socialLinks.youtube}
                 target="_blank" rel="noopener noreferrer">
                YouTube ↗
              </a>
            )}
            {streamer.socialLinks.twitch && (
              <a href={streamer.socialLinks.twitch}
                 target="_blank" rel="noopener noreferrer">
                Twitch ↗
              </a>
            )}
            {streamer.socialLinks.x && (
              <a href={streamer.socialLinks.x}
                 target="_blank" rel="noopener noreferrer">
                X ↗
              </a>
            )}
          </div>
        </section>

        <section>
          <h2>使用デバイス</h2>
          {devices.length === 0 ? (
            <p>現在、使用デバイス情報を調査中です。</p>
          ) : (
            <p>登録デバイス：{devices.length}件</p>
          )}
        </section>

        <section>
          <h2>情報の出典</h2>
          <ul>
            {streamer.sources.map((source) => (
              <li>
                <a href={source.url}
                   target="_blank" rel="noopener noreferrer">
                  {sourceLabels[source.field] ?? source.field}の出典 ↗
                </a>
              </li>
            ))}
          </ul>
          <p class="updated">
            最終確認日：{streamer.lastVerifiedAt ?? "未確認"}
          </p>
        </section>
      </article>
    </main>
</Layout>

<style>
  main {
    max-width: 900px;
    margin: 40px auto;
    padding: 20px;
  }

  .back {
    display: inline-block;
    margin-bottom: 24px;
    color: #2563eb;
  }

  .profile {
    background: white;
    padding: 32px;
    border-radius: 16px;
    box-shadow: 0 3px 12px #00000010;
  }

  h1 {
    margin-top: 0;
    font-size: 32px;
    color: #2563eb;
  }

  .alias {
    font-size: 0.65em;
    font-weight: normal;
    color: #64748b;
  }

  h2 {
    font-size: 20px;
    border-bottom: 2px solid #e5e7eb;
    padding-bottom: 12px;
  }

  section {
    margin-top: 32px;
  }

  dl {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 16px;
  }

  dt {
    font-weight: bold;
    color: #555;
  }

  dd {
    margin: 0;
  }

  dd strong {
    font-size: 26px;
    color: #2563eb;
  }

  .links {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .links a {
    padding: 10px 18px;
    border-radius: 8px;
    background: #eff6ff;
    color: #2563eb;
    text-decoration: none;
    font-weight: bold;
  }

  .links a:hover {
    background: #dbeafe;
  }

  li {
    margin-bottom: 10px;
    overflow-wrap: anywhere;
  }

  a {
    color: #2563eb;
  }

  .updated {
    margin-top: 20px;
    color: #64748b;
    font-size: 13px;
  }

  @media (max-width: 600px) {
    .profile {
      padding: 20px;
    }

    dl {
      grid-template-columns: 110px 1fr;
    }

    h1 {
      font-size: 26px;
    }
  }
</style>
