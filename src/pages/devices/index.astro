---
import Layout from "../../layouts/Layout.astro";
import { createDeviceCatalog } from "../../lib/device-catalog";
import { getValidatedStreamers } from "../../lib/streamers";

const streamers = await getValidatedStreamers();
const devices = createDeviceCatalog(streamers);
const usageCount = devices.reduce((total, device) => total + device.usages.length, 0);
const categories = Array.from(new Set(devices.map((device) => device.type))).sort(
  (a, b) => a.localeCompare(b, "ja")
);

function formatJapaneseDate(date: string) {
  const [year, month, day] = date.split("-").map(Number);
  return `${year}年${month}月${day}日`;
}
---

<Layout
  title="配信者の使用デバイス一覧 | STREAMER AGE"
  description="配信者が使用したことを確認できたマウス・キーボード・モニターなどをまとめています。"
  canonicalPath="/devices/"
>
  <main class="devices-page" data-device-catalog>
    <section class="devices-hero" aria-labelledby="devices-heading">
      <div class="devices-hero__inner">
        <p class="devices-hero__eyebrow">STREAMER DEVICES</p>
        <h1 id="devices-heading">配信者の使用デバイス一覧</h1>
        <p class="devices-hero__lead">
          配信者が使用したことを確認できたマウス・キーボード・モニターなどをまとめています。
        </p>
        <p class="devices-hero__note">
          掲載内容は各出典の日付時点の使用情報です。現在も使用しているとは限りません。
        </p>
        <dl class="devices-summary" aria-label="掲載状況">
          <div>
            <dt>掲載製品</dt>
            <dd>{devices.length}<span>製品</span></dd>
          </div>
          <div>
            <dt>使用記録</dt>
            <dd>{usageCount}<span>件</span></dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="devices-content" aria-labelledby="device-list-heading">
      <div class="devices-content__heading">
        <div>
          <p>DEVICES</p>
          <h2 id="device-list-heading">デバイスを探す</h2>
        </div>
        <p class="device-result-count" role="status" aria-live="polite" aria-atomic="true">
          <strong data-device-count>{devices.length}</strong>製品を表示中
        </p>
      </div>

      <div class="device-filter">
        <label for="device-category-filter">デバイスの種類</label>
        <select id="device-category-filter" data-device-filter>
          <option value="">すべての種類</option>
          {categories.map((category) => <option value={category}>{category}</option>)}
        </select>
      </div>

      <div class="device-catalog-grid">
        {devices.map((device) => (
          <article
            class="device-product-card"
            id={`device-${device.id}`}
            data-device-card
            data-device-type={device.type}
          >
            <div class="device-product-card__header">
              <span class="device-type">{device.type}</span>
              <p class="device-manufacturer">{device.manufacturer}</p>
              <h3>{device.productName}</h3>
            </div>

            <div class="device-users">
              <h4>使用を確認できた配信者</h4>
              <ul>
                {device.usages.map((usage) => (
                  <li data-device-usage>
                    <a
                      class="streamer-link"
                      href={`/streamers/${usage.streamerSlug}/`}
                    >
                      {usage.streamerName}
                      <span aria-hidden="true">→</span>
                    </a>

                    <dl class="usage-meta">
                      {usage.usageConfirmedAt && (
                        <div>
                          <dt>使用確認日</dt>
                          <dd>
                            <time datetime={usage.usageConfirmedAt}>
                              {formatJapaneseDate(usage.usageConfirmedAt)}
                            </time>
                          </dd>
                        </div>
                      )}
                      <div>
                        <dt>情報の出典</dt>
                        <dd>
                          <a
                            href={usage.sourceUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            出典を確認 ↗
                          </a>
                        </dd>
                      </div>
                      <div>
                        <dt>サイト確認日</dt>
                        <dd>
                          <time datetime={usage.lastVerifiedAt}>
                            {formatJapaneseDate(usage.lastVerifiedAt)}
                          </time>
                        </dd>
                      </div>
                    </dl>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
</Layout>

<script>
  document.querySelectorAll<HTMLElement>("[data-device-catalog]").forEach((root) => {
    const filter = root.querySelector<HTMLSelectElement>("[data-device-filter]");
    const count = root.querySelector<HTMLElement>("[data-device-count]");
    const cards = Array.from(
      root.querySelectorAll<HTMLElement>("[data-device-card]")
    );

    if (!filter || !count) return;

    const updateResults = () => {
      let visibleCount = 0;

      for (const card of cards) {
        const visible = !filter.value || card.dataset.deviceType === filter.value;
        card.hidden = !visible;
        if (visible) visibleCount += 1;
      }

      count.textContent = String(visibleCount);
    };

    filter.addEventListener("change", updateResults);
    updateResults();
  });
</script>

<style>
  .devices-page {
    min-width: 0;
  }

  .devices-hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 82% 12%, rgb(117 89 232 / 24%), transparent 34%),
      radial-gradient(circle at 12% 95%, rgb(32 184 165 / 14%), transparent 30%),
      var(--color-navy);
    color: #fff;
  }

  .devices-hero::after {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 3%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 3%) 1px, transparent 1px);
    background-size: 42px 42px;
    content: "";
    mask-image: linear-gradient(to bottom, #000, transparent 92%);
    pointer-events: none;
  }

  .devices-hero__inner,
  .devices-content {
    width: min(calc(100% - 40px), var(--content-width));
    margin-inline: auto;
  }

  .devices-hero__inner {
    position: relative;
    z-index: 1;
    padding-block: 64px;
  }

  .devices-hero__eyebrow,
  .devices-content__heading > div > p {
    margin: 0 0 9px;
    color: #7ce0d2;
    letter-spacing: 0.14em;
    font-size: 11px;
    font-weight: 800;
  }

  h1 {
    max-width: 880px;
    margin: 0;
    font-size: clamp(36px, 5.2vw, 56px);
    letter-spacing: -0.035em;
    line-height: 1.17;
    text-wrap: balance;
  }

  .devices-hero__lead {
    max-width: 760px;
    margin: 18px 0 0;
    color: #d9e1f2;
    font-size: clamp(16px, 2vw, 18px);
    line-height: 1.7;
  }

  .devices-hero__note {
    max-width: 760px;
    margin: 13px 0 0;
    color: var(--color-text-on-dark-muted);
    font-size: 13px;
    line-height: 1.7;
  }

  .devices-summary {
    display: flex;
    gap: 12px;
    margin: 28px 0 0;
  }

  .devices-summary div {
    min-width: 132px;
    padding: 13px 16px;
    border: 1px solid rgb(255 255 255 / 14%);
    border-radius: 13px;
    background: rgb(255 255 255 / 7%);
  }

  .devices-summary dt {
    color: var(--color-text-on-dark-muted);
    font-size: 11px;
    font-weight: 700;
  }

  .devices-summary dd {
    margin: 4px 0 0;
    color: #fff;
    font-size: 26px;
    font-weight: 800;
  }

  .devices-summary dd span {
    margin-left: 3px;
    font-size: 12px;
  }

  .devices-content {
    padding-block: 48px 24px;
  }

  .devices-content__heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 22px;
  }

  .devices-content__heading > div > p {
    color: var(--color-teal);
  }

  .devices-content__heading h2,
  .device-result-count {
    margin: 0;
  }

  .devices-content__heading h2 {
    font-size: clamp(25px, 4vw, 34px);
    letter-spacing: -0.025em;
  }

  .device-result-count {
    color: var(--color-text-muted);
    font-size: 14px;
  }

  .device-result-count strong {
    margin-right: 3px;
    color: var(--color-purple);
    font-size: 24px;
  }

  .device-filter {
    max-width: 360px;
    margin-bottom: 24px;
    padding: 18px;
    border: 1px solid var(--color-border);
    border-radius: 15px;
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
  }

  .device-filter label {
    display: block;
    margin-bottom: 8px;
    color: #475569;
    font-size: 13px;
    font-weight: 700;
  }

  .device-filter select {
    width: 100%;
    min-height: 46px;
    padding: 10px 38px 10px 13px;
    border: 1px solid #cbd5e1;
    border-radius: 11px;
    background: #fff;
    color: var(--color-text);
    font: inherit;
  }

  .device-filter select:focus {
    border-color: var(--color-purple);
    outline: 3px solid rgb(117 89 232 / 22%);
    outline-offset: 1px;
  }

  .device-catalog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    align-items: start;
    gap: 18px;
  }

  .device-product-card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-large);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
  }

  .device-product-card[hidden] {
    display: none;
  }

  .device-product-card__header {
    padding: 22px;
    border-bottom: 1px solid var(--color-border);
    background: linear-gradient(145deg, #fff, #f8f7ff);
  }

  .device-type {
    display: inline-flex;
    padding: 5px 10px;
    border: 1px solid #dcd6ff;
    border-radius: 999px;
    background: var(--color-purple-soft);
    color: #5842bd;
    font-size: 11px;
    font-weight: 800;
  }

  .device-manufacturer {
    margin: 16px 0 5px;
    color: var(--color-teal);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .device-product-card h3 {
    margin: 0;
    overflow-wrap: anywhere;
    color: var(--color-text);
    font-size: 21px;
    line-height: 1.4;
  }

  .device-users {
    padding: 20px 22px 22px;
  }

  .device-users h4 {
    margin: 0 0 13px;
    color: var(--color-text-muted);
    font-size: 12px;
  }

  .device-users ul {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .device-users li {
    min-width: 0;
    padding: 14px;
    border: 1px solid #e8ebf2;
    border-radius: 12px;
    background: #fafbfe;
  }

  .streamer-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    color: #4f35bd;
    font-size: 15px;
    font-weight: 800;
    text-decoration: none;
  }

  .streamer-link:hover,
  .usage-meta a:hover {
    text-decoration: underline;
  }

  .streamer-link:focus-visible,
  .usage-meta a:focus-visible {
    border-radius: 5px;
    outline: 3px solid rgb(32 184 165 / 40%);
    outline-offset: 3px;
  }

  .usage-meta {
    display: grid;
    gap: 7px;
    margin: 12px 0 0;
  }

  .usage-meta div {
    display: flex;
    min-width: 0;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding-top: 7px;
    border-top: 1px solid #e8ebf2;
  }

  .usage-meta dt {
    flex: 0 0 auto;
    color: var(--color-text-muted);
    font-size: 11px;
    font-weight: 700;
  }

  .usage-meta dd {
    min-width: 0;
    margin: 0;
    overflow-wrap: anywhere;
    color: var(--color-text);
    font-size: 12px;
    text-align: right;
  }

  .usage-meta a {
    color: #5842bd;
    font-weight: 700;
    text-decoration: none;
  }

  @media (max-width: 600px) {
    .devices-hero__inner,
    .devices-content {
      width: min(calc(100% - 32px), var(--content-width));
    }

    .devices-hero__inner {
      padding-block: 42px;
    }

    h1 {
      font-size: clamp(31px, 9vw, 40px);
    }

    .devices-summary {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .devices-summary div {
      min-width: 0;
    }

    .devices-content {
      padding-top: 36px;
    }

    .devices-content__heading {
      align-items: center;
    }

    .device-filter {
      max-width: none;
    }

    .device-catalog-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 14px;
    }
  }

  @media (max-width: 340px) {
    .devices-hero__inner,
    .devices-content {
      width: min(calc(100% - 24px), var(--content-width));
    }

    .devices-content__heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }

    .usage-meta div {
      align-items: flex-start;
      flex-direction: column;
      gap: 4px;
    }

    .usage-meta dd {
      text-align: left;
    }
  }
</style>
