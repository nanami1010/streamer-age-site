---
import InfoPage from "../components/InfoPage.astro";
import { CONTACT_LIMITS } from "../lib/contact";

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY?.trim();
const contactFormEnabled =
  import.meta.env.PUBLIC_CONTACT_FORM_ENABLED === "true" &&
  Boolean(turnstileSiteKey);
---

<InfoPage
  title="お問い合わせ | 配信者年齢サイト"
  description="掲載情報の訂正・削除、その他のお問い合わせを受け付けます。"
  canonicalPath="/contact/"
  heading="お問い合わせ"
>
  <p>次のようなご連絡を受け付けます。</p>

  <ul>
    <li>掲載情報の訂正依頼</li>
    <li>掲載情報の削除依頼</li>
    <li>画像、名称、商標、著作物などの権利関係に関するお問い合わせ</li>
    <li>その他のお問い合わせ</li>
  </ul>

  <h2>お問い合わせフォーム</h2>
  {!contactFormEnabled && (
    <p class="status-note" data-contact-unavailable>
      現在、問い合わせの送信機能を準備中です。設定完了後に利用できます。
    </p>
  )}

  <form
    class="contact-form"
    action="/api/contact"
    method="post"
    data-contact-form
    aria-describedby="contact-privacy-note"
  >
    <div class="contact-form__field">
      <label for="contact-type">問い合わせの種類 <span aria-hidden="true">必須</span></label>
      <select id="contact-type" name="type" required disabled={!contactFormEnabled}>
        <option value="">選択してください</option>
        <option value="correction">掲載情報の訂正</option>
        <option value="deletion">削除依頼</option>
        <option value="other">その他</option>
      </select>
    </div>

    <div class="contact-form__field">
      <label for="contact-name">お名前 <span class="contact-form__optional">任意</span></label>
      <input
        id="contact-name"
        name="name"
        type="text"
        maxlength={CONTACT_LIMITS.name}
        autocomplete="name"
        disabled={!contactFormEnabled}
      />
    </div>

    <div class="contact-form__field">
      <label for="contact-email">返信先メールアドレス <span aria-hidden="true">必須</span></label>
      <input
        id="contact-email"
        name="replyEmail"
        type="email"
        maxlength={CONTACT_LIMITS.email}
        autocomplete="email"
        inputmode="email"
        required
        disabled={!contactFormEnabled}
      />
      <p class="contact-form__hint">返信のために使用し、サイト上には公開しません。</p>
    </div>

    <div class="contact-form__field">
      <label for="contact-target">
        対象の配信者名または掲載ページURL
        <span class="contact-form__optional" data-target-requirement>種類により必須</span>
      </label>
      <input
        id="contact-target"
        name="targetReference"
        type="text"
        maxlength={CONTACT_LIMITS.targetReference}
        disabled={!contactFormEnabled}
        data-contact-target
      />
      <p class="contact-form__hint">
        掲載情報の訂正・削除依頼では必須です。配信者名または当サイトの対象ページURLを入力してください。
      </p>
    </div>

    <div class="contact-form__field">
      <label for="contact-agency-name">
        所属事務所名 <span class="contact-form__optional">任意</span>
      </label>
      <input
        id="contact-agency-name"
        name="agencyName"
        type="text"
        maxlength={CONTACT_LIMITS.agencyName}
        disabled={!contactFormEnabled}
      />
    </div>

    <div class="contact-form__field">
      <label for="contact-agency-url">
        所属事務所の公式サイトURL <span class="contact-form__optional">任意</span>
      </label>
      <input
        id="contact-agency-url"
        name="agencyUrl"
        type="url"
        maxlength={CONTACT_LIMITS.agencyUrl}
        inputmode="url"
        placeholder="https://example.com/"
        disabled={!contactFormEnabled}
      />
      <p class="contact-form__hint">確認の参考にする公式サイトがある場合のみ入力してください。</p>
    </div>

    <p class="contact-form__notice">
      お名前、メールアドレス、所属事務所情報の入力だけで本人確認済みとはなりません。運営者が必要に応じて公式サイトなど別の経路で確認します。
    </p>

    <div class="contact-form__field">
      <label for="contact-message">問い合わせ内容 <span aria-hidden="true">必須</span></label>
      <textarea
        id="contact-message"
        name="message"
        rows="8"
        minlength={CONTACT_LIMITS.messageMin}
        maxlength={CONTACT_LIMITS.messageMax}
        required
        disabled={!contactFormEnabled}
      ></textarea>
      <p class="contact-form__hint">
        {CONTACT_LIMITS.messageMin}〜{CONTACT_LIMITS.messageMax}文字で入力してください。添付ファイルは送信できません。
      </p>
    </div>

    <div class="contact-form__trap" aria-hidden="true">
      <label for="contact-website">ウェブサイト</label>
      <input
        id="contact-website"
        name="website"
        type="text"
        tabindex="-1"
        autocomplete="off"
        disabled={!contactFormEnabled}
      />
    </div>

    {contactFormEnabled && (
      <div
        class="cf-turnstile"
        data-sitekey={turnstileSiteKey}
        data-action="contact"
        data-theme="auto"
      ></div>
    )}

    <p id="contact-privacy-note" class="contact-form__privacy">
      送信前に<a href="/privacy/">プライバシーポリシー</a>をご確認ください。
    </p>

    <button type="submit" class="contact-form__submit" disabled={!contactFormEnabled}>
      送信する
    </button>

    <p class="contact-form__result" data-contact-result role="status" aria-live="polite"></p>
  </form>

  <h2>ご連絡時にお知らせいただきたい内容</h2>
  <p>
    対象ページのURL、訂正・削除したい内容、その根拠となる公開情報のURLをお知らせください。権利関係のご連絡では、ご本人または代理人であることを確認する場合があります。
  </p>
</InfoPage>

{contactFormEnabled && (
  <script
    is:inline
    src="https://challenges.cloudflare.com/turnstile/v0/api.js"
    async
    defer
  ></script>
)}

<script>
  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  const result = document.querySelector<HTMLElement>("[data-contact-result]");
  const typeSelect = form?.elements.namedItem("type");
  const targetInput = document.querySelector<HTMLInputElement>("[data-contact-target]");
  const targetRequirement = document.querySelector<HTMLElement>("[data-target-requirement]");

  const syncTargetRequirement = () => {
    if (!(typeSelect instanceof HTMLSelectElement) || !targetInput || !targetRequirement) {
      return;
    }

    const isRequired = typeSelect.value === "correction" || typeSelect.value === "deletion";
    targetInput.required = isRequired;
    targetRequirement.textContent = isRequired ? "必須" : "任意";
    targetRequirement.classList.toggle("contact-form__optional", !isRequired);
  };

  typeSelect?.addEventListener("change", syncTargetRequirement);
  syncTargetRequirement();

  form?.addEventListener(
    "invalid",
    () => {
      if (!result) return;
      result.dataset.state = "error";
      result.textContent = "未入力または形式に誤りがある項目を確認してください。";
    },
    true
  );

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!result || !form.reportValidity()) return;

    const submitButton = form.querySelector<HTMLButtonElement>("[type='submit']");
    if (!submitButton) return;

    submitButton.disabled = true;
    submitButton.textContent = "送信中…";
    result.dataset.state = "pending";
    result.textContent = "送信しています。";

    try {
      const response = await fetch(form.action, {
        method: "POST",
        headers: {
          Accept: "application/json"
        },
        body: new FormData(form)
      });
      const body = (await response.json()) as {
        success?: boolean;
        message?: string;
        fieldErrors?: Record<string, string>;
      };

      if (!response.ok || !body.success) {
        result.dataset.state = "error";
        result.textContent = body.message ?? "送信できませんでした。時間をおいて再度お試しください。";

        const firstField = body.fieldErrors
          ? Object.keys(body.fieldErrors)[0]
          : undefined;
        if (firstField && firstField !== "turnstile") {
          form.elements.namedItem(firstField)?.focus();
        }
        return;
      }

      form.reset();
      syncTargetRequirement();
      result.dataset.state = "success";
      result.textContent = body.message ?? "お問い合わせを受け付けました。";
    } catch {
      result.dataset.state = "error";
      result.textContent = "通信に失敗しました。時間をおいて再度お試しください。";
    } finally {
      const turnstile = (window as Window & {
        turnstile?: { reset: () => void };
      }).turnstile;
      turnstile?.reset();
      submitButton.disabled = false;
      submitButton.textContent = "送信する";
    }
  });
</script>

<style>
  .contact-form {
    display: grid;
    gap: 22px;
    margin-top: 24px;
  }

  .contact-form__field {
    display: grid;
    gap: 8px;
  }

  .contact-form label {
    color: var(--color-navy, #0f172a);
    font-weight: 700;
  }

  .contact-form label span:not(.contact-form__optional) {
    margin-left: 6px;
    color: #b91c1c;
    font-size: 0.78rem;
  }

  .contact-form__optional {
    margin-left: 6px;
    color: #64748b;
    font-size: 0.82rem;
    font-weight: 500;
  }

  .contact-form input,
  .contact-form select,
  .contact-form textarea {
    box-sizing: border-box;
    width: 100%;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    background: #fff;
    color: #0f172a;
    font: inherit;
  }

  .contact-form input,
  .contact-form select {
    min-height: 48px;
    padding: 10px 12px;
  }

  .contact-form textarea {
    min-height: 180px;
    padding: 12px;
    line-height: 1.65;
    resize: vertical;
  }

  .contact-form input:focus-visible,
  .contact-form select:focus-visible,
  .contact-form textarea:focus-visible,
  .contact-form__submit:focus-visible {
    outline: 3px solid #2dd4bf;
    outline-offset: 2px;
  }

  .contact-form input:disabled,
  .contact-form select:disabled,
  .contact-form textarea:disabled {
    cursor: not-allowed;
    background: #f1f5f9;
    color: #64748b;
  }

  .contact-form__hint,
  .contact-form__privacy {
    margin: 0;
    color: #64748b;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .contact-form__notice {
    margin: 0;
    padding: 14px 16px;
    border-left: 4px solid #0f766e;
    border-radius: 8px;
    background: #f0fdfa;
    color: #334155;
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .contact-form__trap {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .contact-form__submit {
    min-height: 48px;
    padding: 12px 24px;
    border: 0;
    border-radius: 10px;
    background: #5b21b6;
    color: #fff;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .contact-form__submit:hover:not(:disabled) {
    background: #4c1d95;
  }

  .contact-form__submit:disabled {
    cursor: not-allowed;
    background: #94a3b8;
  }

  .contact-form__result {
    min-height: 1.8em;
    margin: 0;
    font-weight: 700;
  }

  .contact-form__result[data-state="success"] {
    color: #047857;
  }

  .contact-form__result[data-state="error"] {
    color: #b91c1c;
  }

  @media (max-width: 600px) {
    .contact-form {
      gap: 18px;
    }

    .contact-form__submit {
      width: 100%;
    }
  }
</style>
