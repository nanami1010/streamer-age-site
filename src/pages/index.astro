
---
import streamers from "../data/streamers.json";

// 日本時間を取得
function getTodayJST() {
  const parts = new Intl.DateTimeFormat("en-US", {
    timeZone: "Asia/Tokyo",
    year: "numeric",
    month: "numeric",
    day: "numeric"
  }).formatToParts(new Date());

  const get = (type: string) =>
    Number(parts.find((p) => p.type === type)?.value);

  return {
    year: get("year"),
    month: get("month"),
    day: get("day")
  };
}

// 年齢計算
function calculateAge(birthDate: string | null) {
  if (!birthDate) return null;

  const [year, month, day] = birthDate.split("-").map(Number);
  const today = getTodayJST();

  const age = today.year - year -
    (today.month < month ||
    (today.month === month && today.day < day) ? 1 : 0);

  return Number.isFinite(age) && age >= 0 ? age : null;
}
---

<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="ゲーム配信者の年齢・誕生日・プロフィールを調べられるサイトです。"
    />
    <title>配信者年齢サイト</title>
  </head>

  <body>
    <main>
      <h1>配信者年齢サイト</h1>
      <p>配信者の年齢・誕生日をチェック</p>

      <div class="grid">
        {streamers.map((streamer) => (
          <article class="card">
            <h2>
              <a
                class="profile-link"
                href={`/streamers/${streamer.slug}/`}
              >
                {streamer.name}
                {streamer.aliases.length > 0 && (
                  <span class="alias">
                    （{streamer.aliases.join("・")}）
                  </span>
                )}
              </a>
            </h2>

            <p class="age">
              年齢：
              <strong data-birth={streamer.birthDate ?? ""}>
                {calculateAge(streamer.birthDate) === null
                  ? "非公開"
                  : `${calculateAge(streamer.birthDate)}歳`}
              </strong>
            </p>

            <p class="genre">
              {streamer.genres.join("・")}
            </p>

            <a
              class="detail-link"
              href={`/streamers/${streamer.slug}/`}
            >
              プロフィールを見る →
            </a>
          </article>
        ))}
      </div>
    </main>

    <script>
      const parts = new Intl.DateTimeFormat("en-US", {
        timeZone: "Asia/Tokyo",
        year: "numeric",
        month: "numeric",
        day: "numeric"
      }).formatToParts(new Date());

      const get = (type: string) =>
        Number(parts.find((p) => p.type === type)?.value);

      document.querySelectorAll<HTMLElement>("[data-birth]")
        .forEach((element) => {
          const birth = element.dataset.birth;

          if (!birth) {
            element.textContent = "非公開";
            return;
          }

          const [year, month, day] = birth.split("-").map(Number);

          const age = get("year") - year -
            (get("month") < month ||
            (get("month") === month && get("day") < day) ? 1 : 0);

          element.textContent =
            Number.isFinite(age) && age >= 0
              ? `${age}歳`
              : "非公開";
        });
    </script>
  </body>
</html>

<style>
  body {
    margin: 0;
    font-family: sans-serif;
    background: #f4f6fa;
    color: #222;
  }

  main {
    max-width: 1000px;
    margin: 50px auto;
    padding: 20px;
  }

  h1 {
    font-size: 32px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 20px;
    margin-top: 30px;
  }

  .card {
    background: white;
    padding: 24px;
    border-radius: 12px;
    box-shadow: 0 3px 12px #00000010;
  }

  .card h2 {
    color: #2563eb;
    margin-top: 0;
  }

  .alias {
    color: #64748b;
    font-size: 0.8em;
    font-weight: normal;
  }

  .profile-link {
    color: inherit;
    text-decoration: none;
  }

  .profile-link:hover {
    text-decoration: underline;
  }

  .age {
    margin: 20px 0 12px;
  }

  .age strong {
    font-size: 24px;
  }

  .genre {
    color: #64748b;
    font-size: 14px;
    margin-bottom: 24px;
  }

  .detail-link {
    display: inline-block;
    color: #2563eb;
    font-size: 14px;
    font-weight: bold;
    text-decoration: none;
  }

  .detail-link:hover {
    text-decoration: underline;
  }
</style>
