
---
import streamers from "../data/streamers.json";

// 日本時間の今日の日付を取得する
function getTodayJST() {
  const parts = new Intl.DateTimeFormat("en-US", {
    timeZone: "Asia/Tokyo",
    year: "numeric",
    month: "numeric",
    day: "numeric"
  }).formatToParts(new Date());

  const get = (type: string) =>
    Number(parts.find((p) => p.type === type)?.value);

  return {
    year: get("year"),
    month: get("month"),
    day: get("day")
  };
}

// 生年月日から満年齢を計算する
function calculateAge(birthDate: string | null) {
  if (!birthDate) return null;

  const [year, month, day] = birthDate.split("-").map(Number);
  const today = getTodayJST();

  let age = today.year - year;

  if (
    today.month < month ||
    (today.month === month && today.day < day)
  ) {
    age--;
  }

  return Number.isFinite(age) && age >= 0 ? age : null;
}
---

<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="ゲーム配信者の年齢・誕生日・プロフィールを調べられるサイトです。"
    />
    <title>配信者年齢サイト（テスト）</title>
  </head>

  <body>
    <main>
      <h1>配信者年齢サイト</h1>
      <p>配信者プロフィールの表示テスト</p>

      <div class="grid">
        {streamers.map((streamer) => (
          <article class="card">
            <h2>
			 {streamer.name}
			 {streamer.aliases.length > 0 && (
    		  <span class="alias">
      			（{streamer.aliases.join("・")}）
    		  </span>
  			  )}
			</h2>

            <p>読み：{streamer.nameKana}</p>

            <p>
              年齢：
              <strong data-birth={streamer.birthDate ?? ""}>
                {calculateAge(streamer.birthDate) === null
                  ? "非公開"
                  : `${calculateAge(streamer.birthDate)}歳`}
              </strong>
            </p>

            <p>
              生年月日：{streamer.birthDate ?? "非公開"}
            </p>

            <p>
              ジャンル：{streamer.genres.join("・")}
            </p>

            <p>
              所属：{streamer.affiliation ?? "なし"}
            </p>

            <p>
              使用デバイス：{streamer.devices.length}件
            </p>
          </article>
        ))}
      </div>
    </main>

    <script>
      // ブラウザで開いた時点の年齢へ更新する
      const parts = new Intl.DateTimeFormat("en-US", {
        timeZone: "Asia/Tokyo",
        year: "numeric",
        month: "numeric",
        day: "numeric"
      }).formatToParts(new Date());

      const get = (type: string) =>
        Number(parts.find((p) => p.type === type)?.value);

      document.querySelectorAll<HTMLElement>("[data-birth]")
        .forEach((element) => {
          const birth = element.dataset.birth;

          if (!birth) {
            element.textContent = "非公開";
            return;
          }

          const [year, month, day] = birth.split("-").map(Number);

          const age = get("year") - year -
            (get("month") < month ||
            (get("month") === month && get("day") < day) ? 1 : 0);

          element.textContent =
            Number.isFinite(age) && age >= 0
              ? `${age}歳`
              : "非公開";
        });
    </script>
  </body>
</html>

<style>
  body {
    margin: 0;
    font-family: sans-serif;
    background: #f4f6fa;
    color: #222;
  }

  main {
    max-width: 1000px;
    margin: 50px auto;
    padding: 20px;
  }

  h1 {
    font-size: 32px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
    margin-top: 30px;
  }

  .card {
    background: white;
    padding: 24px;
    border-radius: 12px;
    box-shadow: 0 3px 12px #00000010;
  }

  .card h2 {
    color: #2563eb;
  }

  .card strong {
    font-size: 24px;
  }
  
  .card h2 .alias {
    color: #64748b;
    font-size: 0.8em;
    font-weight: normal;
  }

</style>
