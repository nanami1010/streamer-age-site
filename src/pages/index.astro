
---
import Layout from "../layouts/Layout.astro";
import { getValidatedStreamers } from "../lib/streamers";
import { calculateAge } from "../utils/age";

const streamers = await getValidatedStreamers();
---

<Layout
  title="配信者年齢サイト"
  description="ゲーム配信者の年齢・誕生日・プロフィールを調べられるサイトです。"
>
    <main>
      <h1>配信者年齢サイト</h1>
      <p>配信者の年齢・誕生日をチェック</p>

      <div class="grid">
        {streamers.map((streamer) => (
          <article class="card">
            <h2>
              <a
                class="profile-link"
                href={`/streamers/${streamer.slug}/`}
              >
                {streamer.name}
                {streamer.aliases.length > 0 && (
                  <span class="alias">
                    （{streamer.aliases.join("・")}）
                  </span>
                )}
              </a>
            </h2>

            <p class="age">
              年齢：
              <strong data-birth={streamer.birthDate ?? ""}>
                {calculateAge(streamer.birthDate) === null
                  ? "非公開"
                  : `${calculateAge(streamer.birthDate)}歳`}
              </strong>
            </p>

            <p class="genre">
              {streamer.genres.join("・")}
            </p>

            <a
              class="detail-link"
              href={`/streamers/${streamer.slug}/`}
            >
              プロフィールを見る →
            </a>
          </article>
        ))}
      </div>
    </main>
</Layout>

<style>
  main {
    max-width: 1000px;
    margin: 50px auto;
    padding: 20px;
  }

  h1 {
    font-size: 32px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 20px;
    margin-top: 30px;
  }

  .card {
    background: white;
    padding: 24px;
    border-radius: 12px;
    box-shadow: 0 3px 12px #00000010;
  }

  .card h2 {
    color: #2563eb;
    margin-top: 0;
  }

  .alias {
    color: #64748b;
    font-size: 0.8em;
    font-weight: normal;
  }

  .profile-link {
    color: inherit;
    text-decoration: none;
  }

  .profile-link:hover {
    text-decoration: underline;
  }

  .age {
    margin: 20px 0 12px;
  }

  .age strong {
    font-size: 24px;
  }

  .genre {
    color: #64748b;
    font-size: 14px;
    margin-bottom: 24px;
  }

  .detail-link {
    display: inline-block;
    color: #2563eb;
    font-size: 14px;
    font-weight: bold;
    text-decoration: none;
  }

  .detail-link:hover {
    text-decoration: underline;
  }
</style>
