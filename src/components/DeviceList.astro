---
import type { Streamer } from "../lib/streamers";
import { getDeviceAffiliateLinks } from "../config/device-affiliate-links";
import {
  getDeviceSourceCaution,
  getDeviceSourceLabel
} from "../config/device-sources";

type Device = NonNullable<Streamer["devices"]>[number];

interface Props {
  devices: Device[];
}

const { devices } = Astro.props;

const deviceGroups = Array.from(
  devices.reduce((groups, device) => {
    const categoryDevices = groups.get(device.type) ?? [];
    categoryDevices.push(device);
    groups.set(device.type, categoryDevices);
    return groups;
  }, new Map<string, Device[]>())
).sort(([categoryA], [categoryB]) => categoryA.localeCompare(categoryB, "ja"));

const hasAffiliateLinks = devices.some((device) =>
  Boolean(getDeviceAffiliateLinks(device.productId))
);

function formatJapaneseDate(date: string) {
  const [year, month, day] = date.split("-").map(Number);
  return `${year}年${month}月${day}日`;
}

function formatJapaneseDateTime(dateTime: string) {
  return new Intl.DateTimeFormat("ja-JP", {
    timeZone: "Asia/Tokyo",
    year: "numeric",
    month: "long",
    day: "numeric"
  }).format(new Date(dateTime));
}
---

{devices.length === 0 ? (
  <p class="device-empty">使用デバイスは調査中です。</p>
) : (
  <div class="device-list">
    <p class="device-count">
      <span aria-hidden="true"></span>
      登録デバイス：{devices.length}件
    </p>

    {hasAffiliateLinks && (
      <p class="affiliate-disclosure">
        ※ 商品リンクには広告（PR）を含みます。
      </p>
    )}

    {deviceGroups.map(([category, categoryDevices], groupIndex) => (
      <section class="device-group" aria-labelledby={`device-category-${groupIndex}`}>
        <h3 id={`device-category-${groupIndex}`}>
          <span aria-hidden="true"></span>
          {category}
        </h3>

        <ul class="device-grid">
          {categoryDevices.map((device) => {
            const affiliateLinks = getDeviceAffiliateLinks(device.productId);
            const sourceCaution = getDeviceSourceCaution(device.sourceType);

            return (
              <li class="device-card" data-device-product-id={device.productId}>
              {device.image && (
                <div class="device-image">
                  <img
                    src={device.image}
                    alt={`${device.manufacturer} ${device.productName}`}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              )}

              <div class="device-body">
                <p class="manufacturer">{device.manufacturer}</p>
                <h4>{device.productName}</h4>

                {device.usageConfirmedAt && (
                  <div class="usage-confirmation">
                    <p>
                      <time datetime={device.usageConfirmedAt}>
                        {formatJapaneseDate(device.usageConfirmedAt)}
                      </time>
                      時点の使用情報
                    </p>
                    <p>現在も使用しているかは未確認です。</p>
                  </div>
                )}

                {sourceCaution && (
                  <p class="source-caution">{sourceCaution}</p>
                )}

                {device.verificationNote && (
                  <p class="verification-note">{device.verificationNote}</p>
                )}

                <dl class="device-meta">
                  <div>
                    <dt>情報源</dt>
                    <dd>{getDeviceSourceLabel(device.sourceType)}</dd>
                  </div>
                  {device.sourceCommand && (
                    <div>
                      <dt>確認コマンド</dt>
                      <dd><code>{device.sourceCommand}</code></dd>
                    </div>
                  )}
                  {device.sourceUpdatedAt && (
                    <div>
                      <dt>
                        {device.sourceType === "channelCommand"
                          ? "コマンド最終更新日"
                          : "出典最終更新日"}
                      </dt>
                      <dd>
                        <time datetime={device.sourceUpdatedAt}>
                          {formatJapaneseDateTime(device.sourceUpdatedAt)}
                        </time>
                      </dd>
                    </div>
                  )}
                  <div>
                    <dt>出典URL</dt>
                    <dd>
                      <a
                        href={device.sourceUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        出典を確認 ↗
                      </a>
                    </dd>
                  </div>
                  <div>
                    <dt>サイト確認日</dt>
                    <dd>
                      <time datetime={device.lastVerifiedAt}>
                        {formatJapaneseDate(device.lastVerifiedAt)}
                      </time>
                    </dd>
                  </div>
                </dl>

                {affiliateLinks && (
                  <div
                    class="purchase-links"
                    role="group"
                    aria-label={`${device.productName}の商品リンク`}
                  >
                    {affiliateLinks.amazon && (
                      <a
                        class="purchase-link amazon"
                        href={affiliateLinks.amazon}
                        target="_blank"
                        rel="sponsored nofollow noopener noreferrer"
                      >
                        Amazonで見る（PR）
                      </a>
                    )}
                  </div>
                )}
              </div>
              </li>
            );
          })}
        </ul>
      </section>
    ))}
  </div>
)}

<style>
  .device-empty {
    margin: 0;
    padding: 18px 20px;
    border: 1px dashed #cbd5e1;
    border-radius: 14px;
    background: #f8fafc;
    color: var(--color-text-muted);
    font-size: 14px;
  }

  .device-list {
    min-width: 0;
  }

  .device-count {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 14px;
    color: var(--color-text-muted);
    font-size: 13px;
    font-weight: 700;
  }

  .device-count span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-teal);
    box-shadow: 0 0 0 4px var(--color-teal-soft);
  }

  .affiliate-disclosure {
    margin: 0 0 20px;
    padding: 11px 14px;
    border: 1px solid #ddd6fe;
    border-radius: 11px;
    background: var(--color-purple-soft);
    color: #5842bd;
    font-size: 13px;
    font-weight: 700;
  }

  .device-group {
    margin-top: 26px;
  }

  .device-group:first-of-type {
    margin-top: 20px;
  }

  .device-group h3 {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 0 0 13px;
    color: var(--color-text);
    font-size: 17px;
  }

  .device-group h3 span {
    width: 4px;
    height: 18px;
    border-radius: 999px;
    background: linear-gradient(var(--color-purple), var(--color-teal));
  }

  .device-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 340px));
    gap: 14px;
    justify-content: start;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .device-card {
    min-width: 0;
    overflow: hidden;
    margin: 0;
    border: 1px solid var(--color-border);
    border-radius: 15px;
    background: var(--color-surface);
    box-shadow: 0 8px 24px rgb(15 23 42 / 6%);
  }

  .device-image {
    display: grid;
    aspect-ratio: 16 / 9;
    place-items: center;
    overflow: hidden;
    padding: 14px;
    border-bottom: 1px solid var(--color-border);
    background: linear-gradient(145deg, #f8fafc, var(--color-purple-soft));
  }

  .device-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .device-body {
    padding: 17px;
  }

  .manufacturer {
    margin: 0 0 5px;
    color: var(--color-teal);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  h4 {
    margin: 0 0 15px;
    overflow-wrap: anywhere;
    color: var(--color-text);
    font-size: 17px;
    line-height: 1.45;
  }

  .usage-confirmation {
    margin: 0 0 14px;
    padding: 10px 12px;
    border-left: 3px solid var(--color-teal);
    border-radius: 0 9px 9px 0;
    background: var(--color-teal-soft);
    color: var(--color-text-muted);
    font-size: 11px;
    line-height: 1.55;
  }

  .usage-confirmation p {
    margin: 0;
  }

  .usage-confirmation p:first-child {
    color: var(--color-text);
    font-weight: 800;
  }

  .source-caution,
  .verification-note {
    margin: 0 0 14px;
    padding: 10px 12px;
    border-radius: 9px;
    background: #f8fafc;
    color: var(--color-text-muted);
    font-size: 11px;
    line-height: 1.6;
  }

  .source-caution {
    border-left: 3px solid var(--color-purple);
  }

  .verification-note {
    border-left: 3px solid #b45309;
    background: #fffbeb;
  }

  .device-meta {
    display: grid;
    gap: 8px;
    margin: 0;
  }

  .device-meta div {
    display: flex;
    min-width: 0;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding-top: 8px;
    border-top: 1px solid #eef2f7;
  }

  dt {
    flex: 0 0 auto;
    color: var(--color-text-muted);
    font-size: 11px;
    font-weight: 700;
  }

  dd {
    min-width: 0;
    margin: 0;
    overflow-wrap: anywhere;
    color: var(--color-text);
    font-size: 12px;
    text-align: right;
  }

  .device-meta a {
    color: #5842bd;
    font-weight: 700;
    text-decoration: none;
  }

  .device-meta a:hover {
    text-decoration: underline;
  }

  .device-meta a:focus-visible,
  .purchase-link:focus-visible {
    border-radius: 6px;
    outline: 3px solid rgb(32 184 165 / 45%);
    outline-offset: 3px;
  }

  .purchase-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 8px;
    margin-top: 15px;
  }

  .purchase-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    padding: 8px 12px;
    border-radius: 10px;
    background: #5b36c8;
    color: #fff;
    font-size: 12px;
    font-weight: 800;
    text-decoration: none;
    transition:
      filter 160ms ease,
      transform 160ms ease;
  }

  .purchase-link:hover {
    filter: brightness(0.9);
    transform: translateY(-1px);
  }

  .purchase-link.amazon {
    background: #8a4b08;
  }

  @media (max-width: 600px) {
    .device-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .device-body {
      padding: 16px;
    }

    .purchase-links {
      grid-template-columns: 1fr;
    }
  }
</style>
