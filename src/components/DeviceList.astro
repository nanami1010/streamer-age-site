---
import type { Streamer } from "../lib/streamers";
import { getDeviceAffiliateLinks } from "../config/device-affiliate-links";
import DeviceSourceDetails from "./DeviceSourceDetails.astro";

type Device = NonNullable<Streamer["devices"]>[number];

interface Props {
  devices: Device[];
}

const { devices } = Astro.props;

const sortedDevices = [...devices].sort(
  (deviceA, deviceB) =>
    deviceA.type.localeCompare(deviceB.type, "ja") ||
    deviceA.productName.localeCompare(deviceB.productName, "ja")
);

const hasAffiliateLinks = devices.some((device) =>
  Boolean(getDeviceAffiliateLinks(device.productId))
);
---

{devices.length === 0 ? (
  <p class="device-empty">使用デバイスは調査中です。</p>
) : (
  <div class="device-list">
    <p class="device-count">
      <span aria-hidden="true"></span>
      登録デバイス：{devices.length}件
    </p>

    {hasAffiliateLinks && (
      <p class="affiliate-disclosure">
        ※ 商品リンクには広告（PR）を含みます。
      </p>
    )}

    <ul class="device-grid">
      {sortedDevices.map((device) => {
        const affiliateLinks = getDeviceAffiliateLinks(device.productId);

        return (
          <li class="device-card" data-device-product-id={device.productId}>
            {device.image && (
              <div class="device-image">
                <img
                  src={device.image}
                  alt={`${device.manufacturer} ${device.productName}`}
                  loading="lazy"
                  decoding="async"
                />
              </div>
            )}

            <div class="device-body">
              <div class="device-heading">
                <span class="device-category">{device.type}</span>
                <p class="manufacturer">{device.manufacturer}</p>
                <h3>{device.productName}</h3>
              </div>

              <DeviceSourceDetails
                sourceType={device.sourceType}
                sourceUrl={device.sourceUrl}
                sourceCommand={device.sourceCommand}
                usageConfirmedAt={device.usageConfirmedAt}
                sourceUpdatedAt={device.sourceUpdatedAt}
                lastVerifiedAt={device.lastVerifiedAt}
                verificationNote={device.verificationNote}
              />

              {affiliateLinks && (
                <div
                  class="purchase-links"
                  role="group"
                  aria-label={`${device.productName}の商品リンク`}
                >
                  {affiliateLinks.amazon && (
                    <a
                      class="purchase-link amazon"
                      href={affiliateLinks.amazon}
                      target="_blank"
                      rel="sponsored nofollow noopener noreferrer"
                    >
                      Amazonで見る（PR）
                    </a>
                  )}
                </div>
              )}
            </div>
          </li>
        );
      })}
    </ul>
  </div>
)}

<style>
  .device-empty {
    margin: 0;
    padding: 18px 20px;
    border: 1px dashed #cbd5e1;
    border-radius: 14px;
    background: #f8fafc;
    color: var(--color-text-muted);
    font-size: 14px;
  }

  .device-list {
    min-width: 0;
  }

  .device-count {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 14px;
    color: var(--color-text-muted);
    font-size: 13px;
    font-weight: 700;
  }

  .device-count span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-teal);
    box-shadow: 0 0 0 4px var(--color-teal-soft);
  }

  .affiliate-disclosure {
    margin: 0 0 20px;
    padding: 11px 14px;
    border: 1px solid #ddd6fe;
    border-radius: 11px;
    background: var(--color-purple-soft);
    color: #5842bd;
    font-size: 13px;
    font-weight: 700;
  }

  .device-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .device-card {
    display: flex;
    min-width: 0;
    overflow: hidden;
    flex-direction: column;
    margin: 0;
    border: 1px solid var(--color-border);
    border-radius: 15px;
    background: var(--color-surface);
    box-shadow: 0 8px 24px rgb(15 23 42 / 6%);
  }

  .device-image {
    display: grid;
    width: 100%;
    aspect-ratio: 16 / 9;
    place-items: center;
    overflow: hidden;
    padding: 14px;
    border-bottom: 1px solid var(--color-border);
    background: linear-gradient(145deg, #f8fafc, var(--color-purple-soft));
  }

  .device-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .device-body {
    display: flex;
    min-width: 0;
    width: 100%;
    flex-direction: column;
    padding: 17px;
  }

  .device-heading {
    min-width: 0;
  }

  .device-category {
    display: inline-flex;
    min-height: 26px;
    align-items: center;
    margin-bottom: 12px;
    padding: 3px 9px;
    border-radius: 999px;
    background: var(--color-teal-soft);
    color: #0f766e;
    font-size: 11px;
    font-weight: 800;
  }

  .manufacturer {
    margin: 0 0 5px;
    overflow-wrap: anywhere;
    color: var(--color-teal);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  h3 {
    margin: 0;
    overflow-wrap: anywhere;
    color: var(--color-text);
    font-size: 17px;
    line-height: 1.45;
  }

  .purchase-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 8px;
    margin-top: 15px;
  }

  .purchase-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    padding: 8px 12px;
    border-radius: 10px;
    background: #5b36c8;
    color: #fff;
    font-size: 12px;
    font-weight: 800;
    text-decoration: none;
    transition:
      filter 160ms ease,
      transform 160ms ease;
  }

  .purchase-link:hover {
    filter: brightness(0.9);
    transform: translateY(-1px);
  }

  .purchase-link:focus-visible {
    outline: 3px solid rgb(32 184 165 / 45%);
    outline-offset: 3px;
  }

  .purchase-link.amazon {
    background: #8a4b08;
  }

  @media (min-width: 640px) {
    .device-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .device-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .device-body {
      padding: 16px;
    }

    .purchase-links {
      grid-template-columns: 1fr;
    }
  }
</style>
