---
import { SITE_CONFIG } from "../../site.config.mjs";
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href="/" aria-label={`${SITE_CONFIG.name} トップページ`}>
      <span class="brand__mark" aria-hidden="true">S</span>
      <span class="brand__text">
        <span class="brand__name">STREAMER DB</span>
        <span class="brand__caption">{SITE_CONFIG.name}</span>
      </span>
    </a>
    <nav aria-label="配信者の探し方">
      <a class="generation-link" href="/generations/">同学年で探す</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 10;
    border-bottom: 1px solid rgb(255 255 255 / 10%);
    background: var(--color-navy);
  }

  .site-header__inner {
    display: flex;
    width: min(100% - 40px, var(--content-width));
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-inline: auto;
    padding-block: 16px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    color: #fff;
    text-decoration: none;
  }

  .brand__mark {
    display: grid;
    width: 36px;
    height: 36px;
    place-items: center;
    border: 1px solid rgb(255 255 255 / 24%);
    border-radius: 10px;
    background: linear-gradient(135deg, var(--color-purple), var(--color-teal));
    box-shadow: 0 8px 24px rgb(39 209 183 / 16%);
    font-size: 18px;
    font-weight: 800;
  }

  .brand__text {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .brand__name {
    letter-spacing: 0.08em;
    font-size: 15px;
    font-weight: 800;
  }

  .brand__caption {
    color: var(--color-text-on-dark-muted);
    font-size: 10px;
  }

  .generation-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    padding: 8px 13px;
    border: 1px solid rgb(255 255 255 / 18%);
    border-radius: 10px;
    color: #d9e1f2;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .generation-link:hover {
    border-color: rgb(124 224 210 / 58%);
    color: #fff;
  }

  .generation-link:focus-visible {
    outline: 3px solid rgb(32 184 165 / 50%);
    outline-offset: 3px;
  }

  @media (max-width: 600px) {
    .site-header__inner {
      width: min(100% - 32px, var(--content-width));
      padding-block: 13px;
    }

    .brand__mark {
      width: 34px;
      height: 34px;
    }

    .generation-link {
      padding-inline: 10px;
      font-size: 12px;
    }
  }
</style>
