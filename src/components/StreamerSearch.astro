---
interface Props {
  totalCount: number;
}

const { totalCount } = Astro.props;
---

<div class="streamer-search" data-streamer-search-root>
  <section
    class="search-panel"
    role="search"
    aria-labelledby="streamer-search-label"
  >
    <label id="streamer-search-label" for="streamer-search-input">
      配信者を検索
    </label>

    <div class="search-controls">
      <input
        id="streamer-search-input"
        type="search"
        placeholder="名前・読み・別名で検索"
        autocomplete="off"
        enterkeyhint="search"
        aria-controls="streamer-list"
        aria-describedby="streamer-search-status"
        data-search-input
      />
      <button type="button" data-search-clear disabled>
        クリア
      </button>
    </div>

    <p
      id="streamer-search-status"
      class="result-count"
      role="status"
      aria-live="polite"
      aria-atomic="true"
      data-search-status
    >
      <span data-search-count>{totalCount}</span>件の配信者を表示中
    </p>
  </section>

  <slot />

  <p class="no-results" data-search-empty hidden>
    該当する配信者が見つかりません
  </p>
</div>

<script>
  import { matchesStreamer } from "../utils/search";

  document
    .querySelectorAll<HTMLElement>("[data-streamer-search-root]")
    .forEach((root) => {
      const input = root.querySelector<HTMLInputElement>("[data-search-input]");
      const clearButton = root.querySelector<HTMLButtonElement>("[data-search-clear]");
      const count = root.querySelector<HTMLElement>("[data-search-count]");
      const emptyMessage = root.querySelector<HTMLElement>("[data-search-empty]");
      const cards = Array.from(
        root.querySelectorAll<HTMLElement>("[data-streamer-card]")
      );

      if (!input || !clearButton || !count || !emptyMessage) return;

      const updateResults = () => {
        let visibleCount = 0;

        for (const card of cards) {
          const matches = matchesStreamer(card.dataset.search ?? "", input.value);
          card.hidden = !matches;
          if (matches) visibleCount += 1;
        }

        count.textContent = String(visibleCount);
        emptyMessage.hidden = visibleCount !== 0;
        clearButton.disabled = input.value === "";
      };

      input.addEventListener("input", updateResults);
      clearButton.addEventListener("click", () => {
        input.value = "";
        updateResults();
        input.focus();
      });

      updateResults();
    });
</script>

<style>
  .search-panel {
    margin-top: 30px;
  }

  label {
    display: block;
    margin-bottom: 8px;
    font-weight: bold;
  }

  .search-controls {
    display: flex;
    gap: 10px;
  }

  input {
    box-sizing: border-box;
    min-width: 0;
    min-height: 44px;
    flex: 1;
    padding: 10px 12px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    background: white;
    color: #222;
    font: inherit;
  }

  input:focus {
    border-color: #2563eb;
    outline: 2px solid #bfdbfe;
    outline-offset: 1px;
  }

  button {
    min-height: 44px;
    padding: 10px 16px;
    border: 0;
    border-radius: 8px;
    background: #2563eb;
    color: white;
    font: inherit;
    font-weight: bold;
    cursor: pointer;
  }

  button:focus-visible {
    outline: 2px solid #1e40af;
    outline-offset: 2px;
  }

  button:disabled {
    background: #94a3b8;
    cursor: default;
  }

  .result-count {
    margin: 10px 0 0;
    color: #64748b;
    font-size: 14px;
  }

  .no-results {
    margin-top: 30px;
    padding: 24px;
    border-radius: 12px;
    background: white;
    text-align: center;
    color: #64748b;
  }

  @media (max-width: 600px) {
    .search-controls {
      gap: 8px;
    }

    button {
      padding-inline: 14px;
    }
  }
</style>
