---
interface Props {
  totalCount: number;
  genres: string[];
  schoolYears: number[];
}

const { totalCount, genres, schoolYears } = Astro.props;
---

<div class="streamer-search" data-streamer-search-root>
  <section
    class="search-panel"
    role="search"
    aria-labelledby="streamer-search-label"
  >
    <div class="hero">
      <div class="hero__inner">
        <p class="hero__eyebrow">STREAMER PROFILE DATABASE</p>
        <h1>あの配信者、何歳だっけ？</h1>
        <p class="hero__lead">
          配信者の年齢・誕生日・同学年を検索。使用デバイスもチェック。
        </p>

        <div class="hero-search">
          <label id="streamer-search-label" for="streamer-search-input">
            配信者を検索
          </label>
          <div class="search-controls">
            <span class="search-icon" aria-hidden="true"></span>
            <input
              id="streamer-search-input"
              type="search"
              placeholder="名前・読み・別名で検索"
              autocomplete="off"
              enterkeyhint="search"
              aria-controls="streamer-list"
              aria-describedby="streamer-search-status"
              data-search-input
            />
            <button type="button" data-search-clear disabled>
              クリア
            </button>
          </div>
        </div>

        <div class="filter-area">
          <div class="filter-controls">
            <div class="filter-field">
              <label for="streamer-genre-filter">ジャンル</label>
              <select
                id="streamer-genre-filter"
                aria-controls="streamer-list"
                data-genre-filter
              >
                <option value="">すべて</option>
                {genres.map((genre) => <option value={genre}>{genre}</option>)}
              </select>
            </div>

            <div class="filter-field">
              <label for="streamer-age-filter">年齢</label>
              <select
                id="streamer-age-filter"
                aria-controls="streamer-list"
                data-age-filter
              >
                <option value="">すべて</option>
                <option value="under-20">19歳以下</option>
                <option value="20-24">20〜24歳</option>
                <option value="25-29">25〜29歳</option>
                <option value="30-34">30〜34歳</option>
                <option value="35-39">35〜39歳</option>
                <option value="40-and-over">40歳以上</option>
                <option value="unknown">年齢不明</option>
              </select>
            </div>

            <div class="filter-field">
              <label for="streamer-school-year-filter">生まれた年度</label>
              <select
                id="streamer-school-year-filter"
                aria-controls="streamer-list"
                data-school-year-filter
              >
                <option value="">すべての年度</option>
                {schoolYears.map((year) => (
                  <option value={String(year)}>{year}年度</option>
                ))}
              </select>
            </div>

            <button
              class="reset-button"
              type="button"
              data-filter-reset
              disabled
            >
              条件をリセット
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="results" aria-labelledby="streamer-list-heading">
    <div class="results__heading">
      <div>
        <p class="results__eyebrow">STREAMERS</p>
        <h2 id="streamer-list-heading">配信者一覧</h2>
      </div>
      <p
        id="streamer-search-status"
        class="result-count"
        role="status"
        aria-live="polite"
        aria-atomic="true"
        data-search-status
      >
        <strong data-search-count>{totalCount}</strong>件を表示中
      </p>
    </div>

    <slot />

    <p class="no-results" data-search-empty hidden>
      該当する配信者が見つかりません
    </p>
  </section>
</div>

<script>
  import { calculateAge, getTodayJST } from "../utils/age";
  import { matchesAgeFilter, matchesGenre } from "../utils/filter";
  import { getSchoolYear } from "../utils/generation";
  import { matchesStreamer } from "../utils/search";

  document
    .querySelectorAll<HTMLElement>("[data-streamer-search-root]")
    .forEach((root) => {
      const input = root.querySelector<HTMLInputElement>("[data-search-input]");
      const clearButton = root.querySelector<HTMLButtonElement>("[data-search-clear]");
      const genreSelect = root.querySelector<HTMLSelectElement>("[data-genre-filter]");
      const ageSelect = root.querySelector<HTMLSelectElement>("[data-age-filter]");
      const schoolYearSelect = root.querySelector<HTMLSelectElement>(
        "[data-school-year-filter]"
      );
      const resetButton = root.querySelector<HTMLButtonElement>("[data-filter-reset]");
      const count = root.querySelector<HTMLElement>("[data-search-count]");
      const emptyMessage = root.querySelector<HTMLElement>("[data-search-empty]");
      const cardElements = Array.from(
        root.querySelectorAll<HTMLElement>("[data-streamer-card]")
      );

      if (
        !input ||
        !clearButton ||
        !genreSelect ||
        !ageSelect ||
        !schoolYearSelect ||
        !resetButton ||
        !count ||
        !emptyMessage
      ) return;

      const cards = cardElements.map((element) => {
        let genres: string[] = [];

        try {
          const parsedGenres: unknown = JSON.parse(element.dataset.genres ?? "[]");
          if (
            Array.isArray(parsedGenres) &&
            parsedGenres.every((genre) => typeof genre === "string")
          ) {
            genres = parsedGenres;
          }
        } catch {
          genres = [];
        }

        const birthDate = element.dataset.birthDate || null;

        return {
          element,
          searchIndex: element.dataset.search ?? "",
          genres,
          birthDate,
          schoolYear: getSchoolYear(birthDate)
        };
      });

      const updateResults = () => {
        let visibleCount = 0;
        const selectedAge = ageSelect.value;
        const selectedSchoolYear = schoolYearSelect.value;
        const today = getTodayJST();

        for (const card of cards) {
          const matches =
            matchesStreamer(card.searchIndex, input.value) &&
            matchesGenre(card.genres, genreSelect.value) &&
            (
              selectedAge === "" ||
              matchesAgeFilter(calculateAge(card.birthDate, today), selectedAge)
            ) &&
            (
              selectedSchoolYear === "" ||
              String(card.schoolYear ?? "") === selectedSchoolYear
            );

          card.element.hidden = !matches;
          if (matches) visibleCount += 1;
        }

        count.textContent = String(visibleCount);
        emptyMessage.hidden = visibleCount !== 0;
        clearButton.disabled = input.value === "";
        resetButton.disabled =
          input.value === "" &&
          genreSelect.value === "" &&
          ageSelect.value === "" &&
          schoolYearSelect.value === "";
      };

      input.addEventListener("input", updateResults);
      genreSelect.addEventListener("change", updateResults);
      ageSelect.addEventListener("change", updateResults);
      schoolYearSelect.addEventListener("change", updateResults);
      clearButton.addEventListener("click", () => {
        input.value = "";
        updateResults();
        input.focus();
      });
      resetButton.addEventListener("click", () => {
        input.value = "";
        genreSelect.value = "";
        ageSelect.value = "";
        schoolYearSelect.value = "";
        updateResults();
        input.focus();
      });

      updateResults();
    });
</script>

<style>
  .streamer-search {
    min-width: 0;
  }

  .hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 80% 10%, rgb(117 89 232 / 24%), transparent 34%),
      radial-gradient(circle at 16% 90%, rgb(32 184 165 / 14%), transparent 30%),
      var(--color-navy);
    color: #fff;
  }

  .hero::after {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 3%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 3%) 1px, transparent 1px);
    background-size: 42px 42px;
    content: "";
    mask-image: linear-gradient(to bottom, #000, transparent 85%);
    pointer-events: none;
  }

  .hero__inner,
  .results {
    width: min(calc(100% - 40px), var(--content-width));
    margin-inline: auto;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    padding-block: 72px 30px;
  }

  .hero__eyebrow,
  .results__eyebrow {
    margin: 0 0 12px;
    color: #7ce0d2;
    letter-spacing: 0.14em;
    font-size: 11px;
    font-weight: 800;
  }

  h1 {
    max-width: 100%;
    width: 720px;
    margin: 0;
    font-size: clamp(34px, 6vw, 58px);
    letter-spacing: -0.035em;
    line-height: 1.18;
    text-wrap: balance;
  }

  .hero__lead {
    margin: 18px 0 0;
    color: var(--color-text-on-dark-muted);
    font-size: clamp(15px, 2vw, 18px);
  }

  .hero-search {
    max-width: 760px;
    margin-top: 38px;
  }

  .hero-search label,
  .filter-field label {
    display: block;
    margin-bottom: 9px;
    font-size: 13px;
    font-weight: 700;
  }

  .hero-search label {
    color: #d9e1f2;
  }

  .search-controls {
    position: relative;
    display: flex;
    gap: 10px;
  }

  .search-icon {
    position: absolute;
    top: 50%;
    left: 20px;
    width: 17px;
    height: 17px;
    border: 2px solid #8290aa;
    border-radius: 50%;
    transform: translateY(-55%);
    pointer-events: none;
  }

  .search-icon::after {
    position: absolute;
    right: -5px;
    bottom: -3px;
    width: 7px;
    height: 2px;
    border-radius: 2px;
    background: #8290aa;
    content: "";
    transform: rotate(45deg);
  }

  input,
  select,
  button {
    font: inherit;
  }

  input {
    width: 100%;
    min-width: 0;
    min-height: 58px;
    flex: 1 1 auto;
    padding: 14px 20px 14px 52px;
    border: 1px solid rgb(255 255 255 / 16%);
    border-radius: 14px;
    background: #fff;
    color: var(--color-text);
    box-shadow: 0 14px 38px rgb(0 0 0 / 24%);
    font-size: 16px;
  }

  input::placeholder {
    color: #8994a8;
  }

  input:focus,
  select:focus {
    border-color: var(--color-purple);
    outline: 3px solid rgb(117 89 232 / 22%);
    outline-offset: 1px;
  }

  button {
    min-height: 46px;
    padding: 10px 18px;
    border: 0;
    border-radius: 11px;
    background: var(--color-purple);
    color: #fff;
    font-weight: 800;
    cursor: pointer;
  }

  .search-controls button {
    min-width: 86px;
    min-height: 58px;
    flex: 0 0 86px;
    background: #087f75;
    color: #fff;
    white-space: nowrap;
  }

  .search-controls button:hover:not(:disabled) {
    background: #06665e;
  }

  button:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
    box-shadow: 0 0 0 5px rgb(91 54 200 / 55%);
  }

  button:disabled {
    opacity: 0.46;
    cursor: default;
  }

  .filter-area {
    margin-top: 32px;
  }

  .filter-controls {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr)) auto;
    gap: 16px;
    align-items: end;
    padding: 22px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-large);
    background: rgb(255 255 255 / 96%);
    box-shadow: var(--shadow-card);
  }

  .filter-field label {
    color: #475569;
  }

  select {
    width: 100%;
    min-height: 46px;
    padding: 10px 38px 10px 13px;
    border: 1px solid #cbd5e1;
    border-radius: 11px;
    background: #fff;
    color: var(--color-text);
  }

  .reset-button {
    min-width: 144px;
    background: #5b36c8;
    color: #fff;
    white-space: nowrap;
  }

  .reset-button:hover:not(:disabled) {
    background: #4726a8;
  }

  .results {
    padding-block: 54px 34px;
  }

  .results__heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 24px;
  }

  .results__eyebrow {
    margin-bottom: 5px;
    color: var(--color-teal);
  }

  .results h2 {
    margin: 0;
    font-size: clamp(25px, 4vw, 34px);
    letter-spacing: -0.025em;
  }

  .result-count {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 14px;
  }

  .result-count strong {
    margin-right: 3px;
    color: var(--color-purple);
    font-size: 24px;
  }

  .no-results {
    margin: 0;
    padding: 48px 24px;
    border: 1px dashed #cbd5e1;
    border-radius: var(--radius-large);
    background: var(--color-surface);
    color: var(--color-text-muted);
    text-align: center;
  }

  @media (max-width: 768px) {
    .hero__inner {
      padding-block: 56px 28px;
    }

    .filter-controls {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .reset-button {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 600px) {
    .hero__inner,
    .results {
      width: min(calc(100% - 32px), var(--content-width));
    }

    .hero__inner {
      padding-block: 40px 24px;
    }

    h1 {
      font-size: clamp(31px, 8.8vw, 36px);
      letter-spacing: -0.045em;
      line-height: 1.3;
    }

    .hero__lead {
      max-width: 310px;
      line-height: 1.7;
    }

    .hero-search {
      margin-top: 30px;
    }

    .search-controls {
      gap: 8px;
    }

    input {
      min-height: 54px;
      padding-left: 46px;
      font-size: 16px;
    }

    .search-icon {
      left: 17px;
    }

    .search-controls button {
      min-width: 76px;
      min-height: 54px;
      flex-basis: 76px;
      padding-inline: 12px;
    }

    .filter-area {
      margin-top: 26px;
    }

    .filter-controls {
      grid-template-columns: 1fr;
      gap: 14px;
      padding: 18px;
    }

    .reset-button {
      grid-column: auto;
      width: 100%;
    }

    .results {
      padding-top: 44px;
    }

    .results__heading {
      align-items: center;
    }
  }

  @media (max-width: 340px) {
    .hero__inner,
    .results {
      width: min(calc(100% - 24px), var(--content-width));
    }

    h1 {
      font-size: 30px;
      overflow-wrap: anywhere;
    }

    .search-controls button {
      min-width: 72px;
      flex-basis: 72px;
      padding-inline: 10px;
    }
  }
</style>
