---
interface Props {
  totalCount: number;
  genres: string[];
}

const { totalCount, genres } = Astro.props;
---

<div class="streamer-search" data-streamer-search-root>
  <section
    class="search-panel"
    role="search"
    aria-labelledby="streamer-search-label"
  >
    <label
      id="streamer-search-label"
      class="search-label"
      for="streamer-search-input"
    >
      配信者を検索
    </label>

    <div class="search-controls">
      <input
        id="streamer-search-input"
        type="search"
        placeholder="名前・読み・別名で検索"
        autocomplete="off"
        enterkeyhint="search"
        aria-controls="streamer-list"
        aria-describedby="streamer-search-status"
        data-search-input
      />
      <button type="button" data-search-clear disabled>
        クリア
      </button>
    </div>

    <div class="filter-controls">
      <div class="filter-field">
        <label for="streamer-genre-filter">ジャンル</label>
        <select
          id="streamer-genre-filter"
          aria-controls="streamer-list"
          data-genre-filter
        >
          <option value="">すべて</option>
          {genres.map((genre) => <option value={genre}>{genre}</option>)}
        </select>
      </div>

      <div class="filter-field">
        <label for="streamer-age-filter">年齢</label>
        <select
          id="streamer-age-filter"
          aria-controls="streamer-list"
          data-age-filter
        >
          <option value="">すべて</option>
          <option value="under-20">19歳以下</option>
          <option value="20-24">20〜24歳</option>
          <option value="25-29">25〜29歳</option>
          <option value="30-34">30〜34歳</option>
          <option value="35-39">35〜39歳</option>
          <option value="40-and-over">40歳以上</option>
          <option value="unknown">年齢不明</option>
        </select>
      </div>

      <button
        class="reset-button"
        type="button"
        data-filter-reset
        disabled
      >
        条件をリセット
      </button>
    </div>

    <p
      id="streamer-search-status"
      class="result-count"
      role="status"
      aria-live="polite"
      aria-atomic="true"
      data-search-status
    >
      <span data-search-count>{totalCount}</span>件の配信者を表示中
    </p>
  </section>

  <slot />

  <p class="no-results" data-search-empty hidden>
    該当する配信者が見つかりません
  </p>
</div>

<script>
  import { calculateAge, getTodayJST } from "../utils/age";
  import { matchesAgeFilter, matchesGenre } from "../utils/filter";
  import { matchesStreamer } from "../utils/search";

  document
    .querySelectorAll<HTMLElement>("[data-streamer-search-root]")
    .forEach((root) => {
      const input = root.querySelector<HTMLInputElement>("[data-search-input]");
      const clearButton = root.querySelector<HTMLButtonElement>("[data-search-clear]");
      const genreSelect = root.querySelector<HTMLSelectElement>("[data-genre-filter]");
      const ageSelect = root.querySelector<HTMLSelectElement>("[data-age-filter]");
      const resetButton = root.querySelector<HTMLButtonElement>("[data-filter-reset]");
      const count = root.querySelector<HTMLElement>("[data-search-count]");
      const emptyMessage = root.querySelector<HTMLElement>("[data-search-empty]");
      const cardElements = Array.from(
        root.querySelectorAll<HTMLElement>("[data-streamer-card]")
      );

      if (
        !input ||
        !clearButton ||
        !genreSelect ||
        !ageSelect ||
        !resetButton ||
        !count ||
        !emptyMessage
      ) return;

      const cards = cardElements.map((element) => {
        let genres: string[] = [];

        try {
          const parsedGenres: unknown = JSON.parse(element.dataset.genres ?? "[]");
          if (
            Array.isArray(parsedGenres) &&
            parsedGenres.every((genre) => typeof genre === "string")
          ) {
            genres = parsedGenres;
          }
        } catch {
          genres = [];
        }

        return {
          element,
          searchIndex: element.dataset.search ?? "",
          genres,
          birthDate: element.dataset.birthDate || null
        };
      });

      const updateResults = () => {
        let visibleCount = 0;
        const selectedAge = ageSelect.value;
        const today = getTodayJST();

        for (const card of cards) {
          const matches =
            matchesStreamer(card.searchIndex, input.value) &&
            matchesGenre(card.genres, genreSelect.value) &&
            (
              selectedAge === "" ||
              matchesAgeFilter(calculateAge(card.birthDate, today), selectedAge)
            );

          card.element.hidden = !matches;
          if (matches) visibleCount += 1;
        }

        count.textContent = String(visibleCount);
        emptyMessage.hidden = visibleCount !== 0;
        clearButton.disabled = input.value === "";
        resetButton.disabled =
          input.value === "" &&
          genreSelect.value === "" &&
          ageSelect.value === "";
      };

      input.addEventListener("input", updateResults);
      genreSelect.addEventListener("change", updateResults);
      ageSelect.addEventListener("change", updateResults);
      clearButton.addEventListener("click", () => {
        input.value = "";
        updateResults();
        input.focus();
      });
      resetButton.addEventListener("click", () => {
        input.value = "";
        genreSelect.value = "";
        ageSelect.value = "";
        updateResults();
        input.focus();
      });

      updateResults();
    });
</script>

<style>
  .search-panel {
    margin-top: 30px;
  }

  .search-label,
  .filter-field label {
    display: block;
    margin-bottom: 8px;
    font-weight: bold;
  }

  .search-controls {
    display: flex;
    gap: 10px;
  }

  input {
    box-sizing: border-box;
    min-width: 0;
    min-height: 44px;
    flex: 1;
    padding: 10px 12px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    background: white;
    color: #222;
    font: inherit;
  }

  .filter-controls {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr)) auto;
    gap: 10px;
    align-items: end;
    margin-top: 16px;
  }

  select {
    box-sizing: border-box;
    width: 100%;
    min-height: 44px;
    padding: 10px 36px 10px 12px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    background: white;
    color: #222;
    font: inherit;
  }

  input:focus,
  select:focus {
    border-color: #2563eb;
    outline: 2px solid #bfdbfe;
    outline-offset: 1px;
  }

  button {
    min-height: 44px;
    padding: 10px 16px;
    border: 0;
    border-radius: 8px;
    background: #2563eb;
    color: white;
    font: inherit;
    font-weight: bold;
    cursor: pointer;
  }

  button:focus-visible {
    outline: 2px solid #1e40af;
    outline-offset: 2px;
  }

  button:disabled {
    background: #94a3b8;
    cursor: default;
  }

  .result-count {
    margin: 10px 0 0;
    color: #64748b;
    font-size: 14px;
  }

  .no-results {
    margin-top: 30px;
    padding: 24px;
    border-radius: 12px;
    background: white;
    text-align: center;
    color: #64748b;
  }

  @media (max-width: 600px) {
    .search-controls {
      gap: 8px;
    }

    .filter-controls {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    button {
      padding-inline: 14px;
    }

    .reset-button {
      width: 100%;
    }
  }
</style>
